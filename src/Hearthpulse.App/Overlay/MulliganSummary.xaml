<UserControl x:Class="Hearthpulse.App.Overlay.MulliganSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The mulligan summary under the offered cards (the bars are over them, MulliganPanel): the impact of the keeps,
         or why there are no numbers; the source and slice ("By your deck, N games, data from <date>" for a decklist's
         numbers), the estimate and curve notes in the tooltip. One line, above the Confirm button.
         DataContext: OverlayViewModel. Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:VisibleWhen x:Key="Vis" />
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayCardSolid}"
            HorizontalAlignment="Center" Padding="12,3,12,4" ToolTip="{Binding MulliganDetails}" o:OverlayHit.Interactive="True"
            ToolTipService.InitialShowDelay="200">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding MulliganSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Base}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MulliganImpactGood}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MulliganImpactBad}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="&#xF02FD;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="4,0,0,0"
                           Visibility="{Binding MulliganHasWarnings, Converter={StaticResource Vis}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
