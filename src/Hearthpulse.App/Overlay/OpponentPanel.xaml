<UserControl x:Class="Hearthpulse.App.Overlay.OpponentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Hearthpulse.App.Overlay"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls">
    <!-- Content of the "opponent" overlay panel: the opponent's hero, hand and deck counts, the cards it played. Its hand is
         on the marks over its fanned cards (opponent-hand-fan), its Secrets on the game's own icons and the Secrets panel.
         Same tree as the Avalonia OpponentPanel.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Overlay/OverlayPanels.xaml" />
    </UserControl.Resources>
    <Border Style="{StaticResource OverlayCard}" Width="214">
        <StackPanel>
            <Border Style="{StaticResource OverlayHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Portrait in a gold ring -->
                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Padding="1">
                        <Border CornerRadius="16" Background="{StaticResource Surface3}" i:CardArt.Portrait="{Binding OpponentHeroId}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OpponentTitle}" Style="{StaticResource OverlayHeaderTitle}" />
                        <!-- Class and rank; none when the class heads the panel and no rank is known, so the title sits by the portrait -->
                        <TextBlock Text="{Binding OpponentSubtitle}" Style="{StaticResource OverlayHeaderNote}"
                                   Visibility="{Binding OpponentSubtitle, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        <StackPanel Margin="12,0,12,10">
            <!-- Hand and deck: the numbers first, on one dark plate -->
            <Border Style="{StaticResource OverlayStatPlate}" Margin="0,10,0,0">
                <UniformGrid Columns="2">
                    <StackPanel>
                        <TextBlock Text="{Binding OpponentHand}" Style="{StaticResource OverlayStatValue}" FontSize="17" />
                        <TextBlock Text="{i:Loc Overlay.Opponent.Hand}" Style="{StaticResource OverlayStatLabel}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding OpponentDeck}" Style="{StaticResource OverlayStatValue}" FontSize="17" />
                        <TextBlock Text="{i:Loc Overlay.Opponent.Deck}" Style="{StaticResource OverlayStatLabel}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <ContentControl Style="{StaticResource OverlaySection}" Content="{i:Loc Overlay.Opponent.Played}" Margin="0,12,0,6" Visibility="{Binding Played, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding Played}" ItemTemplate="{StaticResource PlayedTemplate}" />
            <!-- A long game: the oldest played cards fold into this line (named in its tip), so the panel ends above the counters -->
            <TextBlock Text="{Binding PlayedEarlier}" ToolTip="{Binding PlayedEarlierTip}" Style="{StaticResource OverlayHeaderNote}" Margin="4,2,0,0"
                       Background="Transparent" o:OverlayHit.Interactive="True" Visibility="{Binding PlayedEarlier, Converter={StaticResource Vis}}" />
        </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
