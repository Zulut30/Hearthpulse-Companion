  <PropertyGroup>
    <AssemblyName>Hearthpulse</AssemblyName>
    <IntermediateOutputPath>C:\Users\zulut\AppData\Local\Temp\hpc1\obj\Hearthpulse.App\release\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>C:\Users\zulut\AppData\Local\Temp\hpc1\obj\Hearthpulse.App\</BaseIntermediateOutputPath>
