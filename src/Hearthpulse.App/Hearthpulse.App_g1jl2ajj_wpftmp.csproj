    <_TargetAssemblyProjectName>Hearthpulse.App</_TargetAssemblyProjectName>
    <RootNamespace>Hearthpulse.App</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hearthpulse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hearthpulse.ico</ApplicationIcon>
    <Version>0.15.0</Version>
    <HearthpulsePresentationFlavor>Wpf</HearthpulsePresentationFlavor>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- PerMonitorV2 is declared in app.manifest for WPF; the WinForms analyzer only covers the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The GC compacts sooner instead of keeping freed heap committed: 10-20 MB less working set with every page
         open (tools/Hearthpulse.Bench ram), for ~6 % more GC time on a log replay. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hearthpulse.Core\Hearthpulse.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared presentation's layout modules (ChartGeometry, CardPreviewLayout, ...) are internal; the tests read them. -->
    <InternalsVisibleTo Include="Hearthpulse.Presentation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hearthstone's mana gem (c) Blizzard Entertainment, cut by tools/mana/extract_mana_gem.py -->
    <!-- Montserrat: SIL Open Font License 1.1. Material Design Icons: Pictogrammers (Apache 2.0). -->
    <!-- The theme source is also kept as text so other colour themes can be built from it at runtime. -->
    <EmbeddedResource Include="Themes\Theme.xaml" LogicalName="Hearthpulse.Theme.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped next to the exe so every installer carries the licence and the third-party notices. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
