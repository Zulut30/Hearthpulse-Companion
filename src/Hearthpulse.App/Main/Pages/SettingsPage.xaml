<UserControl x:Class="Hearthpulse.App.Main.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:st="clr-namespace:Hearthpulse.App.Main.SettingsTabs">
    <!-- The Settings page: tabs General / Appearance / Overlay / Tracker / Stream / Account / Data / About (the last one
         shown is kept in AppSettings.SettingsTab) and the search over them. Built on the first visit
         (MainWindow.SettingsView); the window keeps its scrolling frame PageSettings and the logic (MainWindow.Settings.cs). -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <StackPanel Margin="40,0,40,120" MaxWidth="780" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Settings}" />
            <TextBlock Text="{i:Loc Settings.Title}" Style="{StaticResource PageTitle}" />
        </StackPanel>
        <c:Wave Style="{StaticResource PageRule}" />

        <!-- Search over every tab; while a query is typed its matches replace the tabs -->
        <st:SettingsSearchBox x:Name="SettingsSearchBar" />

        <StackPanel x:Name="SettingsTabsArea" i:Motion.RevealOnShow="True" Visibility="{Binding SettingsSearching, Converter={StaticResource Vis}, ConverterParameter=!}">
        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,20">
            <WrapPanel>
                <RadioButton x:Name="SettingsTabGeneral" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.General}" GroupName="SettingsTab" Tag="General" IsChecked="True" Checked="OnTab" />
                <RadioButton x:Name="SettingsTabAppearance" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Appearance}" GroupName="SettingsTab" Tag="Appearance" Checked="OnTab" />
                <RadioButton x:Name="SettingsTabOverlay" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Overlay}" GroupName="SettingsTab" Tag="Overlay" Checked="OnTab" />
                <RadioButton x:Name="SettingsTabTracker" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Tracker}" GroupName="SettingsTab" Tag="Tracker" Checked="OnTab" />
                <RadioButton x:Name="SettingsTabStream" Style="{StaticResource Tab}" Content="{i:Loc Stream.Tab}" GroupName="SettingsTab" Tag="Stream" Checked="OnTab" />
                <RadioButton x:Name="SettingsTabAccount" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Account}" GroupName="SettingsTab" Tag="Account" Checked="OnTab" />
                <RadioButton x:Name="SettingsTabData" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.Data}" GroupName="SettingsTab" Tag="Data" Checked="OnTab" />
                <RadioButton x:Name="SettingsTabAbout" Style="{StaticResource Tab}" Content="{i:Loc Settings.Tab.About}" GroupName="SettingsTab" Tag="About" Checked="OnTab" />
            </WrapPanel>
        </Border>

        <!-- ===== General: language, app ===== -->
        <st:GeneralSettings x:Name="SettingsGeneral" i:Motion.RevealOnShow="True" />

        <!-- ===== Appearance: theme gallery, accent, page background, corners, density, size ===== -->
        <st:AppearanceSettings x:Name="SettingsAppearance" Visibility="Collapsed" i:Motion.RevealOnShow="True" />

        <!-- ===== Overlay: what is drawn over the game, its size, panel layout ===== -->
        <st:OverlaySettings x:Name="SettingsOverlay" Visibility="Collapsed" i:Motion.RevealOnShow="True" />

        <!-- ===== Tracker: the Constructed deck tracker, counters and mulligan ===== -->
        <st:TrackerSettings x:Name="SettingsTracker" Visibility="Collapsed" i:Motion.RevealOnShow="True" />

        <!-- ===== Stream: streamer mode and the OBS windows ===== -->
        <st:StreamSettings x:Name="SettingsStream" Visibility="Collapsed" i:Motion.RevealOnShow="True" />

        <!-- ===== Account: the hearthpulse.net sign-in ===== -->
        <st:AccountSettings x:Name="SettingsAccount" Visibility="Collapsed" i:Motion.RevealOnShow="True" />

        <!-- ===== Data: history, the data folder, where the numbers come from ===== -->
        <st:DataSettings x:Name="SettingsData" Visibility="Collapsed" i:Motion.RevealOnShow="True" />

        <!-- ===== About: version, updates, licences ===== -->
        <st:AboutSettings x:Name="SettingsAbout" Visibility="Collapsed" i:Motion.RevealOnShow="True" />
        </StackPanel>

    </StackPanel>
</UserControl>
