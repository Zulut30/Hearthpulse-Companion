<UserControl x:Class="Hearthpulse.App.Main.Pages.CollectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The Collection page (docs/collection-page.md): expansions, hero skins, coins and card backs read from the game,
         each tab with its status line and empty states. Same tree as the Avalonia CollectionPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Meta/MetaResources.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Pages/LibraryLook.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A sum tile: the stats' KPI card (label, gold rule, big value, caption) with its own tip; its words wrap, never cut -->
            <DataTemplate x:Key="CollectionSumTile" DataType="{x:Type m:CollectionSumTile}">
                <Border Style="{DynamicResource TileCard}" Padding="16,12,16,12" Margin="0,0,12,12" ToolTip="{Binding Tip}"
                        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Value}">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        <Border Width="22" Height="2" CornerRadius="1" Background="{StaticResource AccentLine}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Value}" Style="{StaticResource Stat}" FontSize="{StaticResource FontSizeHeadline}" Margin="0,4,0,2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- A set's tile: name and percent, its bar, playable and unique counts, the dust line, rarities 2x2 -->
            <DataTemplate x:Key="CollectionSetTile" DataType="{x:Type m:CollectionSetView}">
                <Border x:Name="Tile" Style="{DynamicResource TileCard}" Padding="16,12" Margin="0,0,12,12" AutomationProperties.Name="{Binding A11y, Mode=OneTime}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name, Mode=OneTime}" Style="{StaticResource H2}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="44" LineStackingStrategy="BlockLineHeight" LineHeight="22" ToolTip="{Binding Name, Mode=OneTime}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Percent, Mode=OneTime}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeHeadline}"
                                       Foreground="{StaticResource StatText}" Margin="12,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Text="{Binding Group, Mode=OneTime}" Style="{StaticResource Caption}" Visibility="{Binding HasGroup, Mode=OneTime, Converter={StaticResource Vis}}" />
                        <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Value="{Binding Fraction, Mode=OneTime}" Margin="0,8,0,0"
                                     Opacity="{Binding ArtOpacity, Mode=OneTime}" />
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{i:Loc CollectionPage.Set.Playable}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Playable, Mode=OneTime}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{i:Loc CollectionPage.Set.Unique}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Unique, Mode=OneTime}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" />
                            </StackPanel>
                        </UniformGrid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DustGlyph" Text="{Binding DustGlyph, Mode=OneTime}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Muted}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Dust, Mode=OneTime}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{i:Loc CollectionPage.Set.EstimateTip}"
                                    Visibility="{Binding Estimate, Mode=OneTime, Converter={StaticResource Vis}}">
                                <TextBlock Text="{i:Loc Collection.Mark.Estimate}" Style="{StaticResource Caption}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,4,0,0" Background="Transparent" ToolTip="{i:Loc CollectionPage.Set.UncraftableTip}"
                              Visibility="{Binding HasUncraftable, Mode=OneTime, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xF033E;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Muted}" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Uncraftable, Mode=OneTime}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rarities, Mode=OneTime}" Margin="0,12,-12,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:CollectionRarityView}">
                                    <!-- The rarity's colour always comes with its name -->
                                    <StackPanel Margin="0,0,12,8" Background="Transparent" ToolTip="{Binding Tip, Mode=OneTime}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding Rarity, Mode=OneTime, Converter={StaticResource KeyBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneTime}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource ShareBar}" Height="4" Foreground="{Binding Rarity, Mode=OneTime, Converter={StaticResource KeyBrush}}"
                                                         Value="{Binding Fraction, Mode=OneTime}" VerticalAlignment="Center" Opacity="{Binding ArtOpacity, Mode=OneTime}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count, Mode=OneTime}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Golden, Mode=OneTime}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding HasGolden, Mode=OneTime, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Complete, Mode=OneTime}" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource BestEdge}" />
                        <Setter TargetName="DustGlyph" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A hero skin: its art 112x112 (the full card on hover), the name, "Not owned" under it; a lock on the art -->
            <DataTemplate x:Key="CollectionSkinTile" DataType="{x:Type m:CollectionItemView}">
                <StackPanel Width="112" Margin="0,0,12,16" Background="Transparent" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding A11y}">
                    <Grid Width="112" Height="112">
                        <Border CornerRadius="{StaticResource RadiusMedium}" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                Opacity="{Binding ArtOpacity}">
                            <Border CornerRadius="{StaticResource RadiusMedium}" i:CardArt.Portrait="{Binding CardId}" c:CardPreview.CardId="{Binding CardId}" />
                        </Border>
                        <Border Style="{StaticResource TileBadge}" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
                            <TextBlock x:Name="Badge" Text="{Binding Badge}" Style="{StaticResource TileBadgeGlyph}" Foreground="{StaticResource Muted}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="34" LineStackingStrategy="BlockLineHeight" LineHeight="17" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding HasState, Converter={StaticResource Vis}}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Favourite}" Value="True">
                        <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A coin: the coin card's art in a gold-rimmed circle (a placeholder glyph without the card), its name -->
            <DataTemplate x:Key="CollectionCoinTile" DataType="{x:Type m:CollectionItemView}">
                <StackPanel Width="112" Margin="0,0,12,16" Background="Transparent" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding A11y}">
                    <Grid Width="80" Height="80">
                        <Border CornerRadius="40" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2" Opacity="{Binding ArtOpacity}">
                            <Grid>
                                <TextBlock Text="&#xF0695;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeDisplay}" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasArt, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                <Border Width="76" Height="76" CornerRadius="38" i:CardArt.Portrait="{Binding CardId}" c:CardPreview.CardId="{Binding CardId}"
                                        Visibility="{Binding HasArt, Converter={StaticResource Vis}}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TileBadge}" VerticalAlignment="Bottom" Margin="0" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
                            <TextBlock x:Name="Badge" Text="{Binding Badge}" Style="{StaticResource TileBadgeGlyph}" Foreground="{StaticResource Muted}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="34" LineStackingStrategy="BlockLineHeight" LineHeight="17" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding HasState, Converter={StaticResource Vis}}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Favourite}" Value="True">
                        <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A card back without art: a double frame over the theme's motif, a medallion shaped by its id with the group's glyph -->
            <DataTemplate x:Key="CollectionBackTile" DataType="{x:Type m:CardBackView}">
                <StackPanel Width="112" Margin="0,0,12,16" Background="Transparent" AutomationProperties.Name="{Binding A11y}">
                    <StackPanel.ToolTip>
                        <StackPanel MaxWidth="280">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasDescription, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Standing}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel.ToolTip>
                    <!-- The frame dims (not owned, saved data); the badge on it keeps its strength, as on the skins and coins -->
                    <Grid Width="96" Height="128">
                        <Grid Opacity="{Binding Opacity}">
                            <Border CornerRadius="{StaticResource RadiusMedium}" Background="{StaticResource Surface2}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" />
                            <!-- The theme's motif, turned by the back's id: no two neighbours show it the same way -->
                            <Border Margin="8" CornerRadius="{StaticResource RadiusSmall}" ClipToBounds="True" Opacity="0.5" IsHitTestVisible="False">
                                <Rectangle Margin="-32,-16" Fill="{StaticResource MotifBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="{Binding MotifAngle}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                            <Border Margin="8" CornerRadius="{StaticResource RadiusSmall}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" />
                            <!-- The medallion: its shape and turn by the id, a gold edge of the same shape under it -->
                            <Grid Width="64" Height="64">
                                <c:Scallop Fill="{StaticResource AccentLine}" Depth="0.24" Lobes="{Binding Lobes}" Angle="{Binding Angle}" />
                                <c:Scallop Margin="2" Fill="{StaticResource AccentContainer}" Depth="0.24" Lobes="{Binding Lobes}" Angle="{Binding Angle}" />
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSubhead}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource TileBadge}" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
                            <TextBlock x:Name="Badge" Text="{Binding Badge}" Style="{StaticResource TileBadgeGlyph}" Foreground="{StaticResource Muted}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="34" LineStackingStrategy="BlockLineHeight" LineHeight="17" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding HasState, Converter={StaticResource Vis}}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Favourite}" Value="True">
                        <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A group's head over its tiles: (the class's hero) name, "14 of 58" on the right, the bar -->
            <DataTemplate x:Key="CollectionGroupHead" DataType="{x:Type m:CollectionGroupView}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Width="48" Height="48" Margin="0,0,12,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}"
                            Opacity="{Binding ArtOpacity}" Visibility="{Binding HasPortrait, Converter={StaticResource Vis}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource H2}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}"
                                 Value="{Binding Fraction, Mode=OneWay}" Margin="0,8,0,0" Opacity="{Binding ArtOpacity}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,0,40,120">
            <!-- The glyph, then the title in the rest of the width: a long title wraps under itself. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Collection}" />
                <TextBlock Grid.Column="1" Text="{i:Loc CollectionPage.Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            </Grid>
            <c:Wave Style="{StaticResource PageRule}" />

            <!-- The tabs; the set filter on their right (on Expansions only) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabSets" Style="{StaticResource Tab}" Content="{i:Loc CollectionPage.Tab.Sets}" GroupName="CollectionTab"
                                     IsChecked="{Binding CollectionTabSets}" ToolTip="{i:Loc CollectionPage.Tab.SetsTip}" />
                        <RadioButton x:Name="TabSkins" Style="{StaticResource Tab}" Content="{i:Loc CollectionPage.Tab.Skins}" GroupName="CollectionTab"
                                     IsChecked="{Binding CollectionTabSkins}" ToolTip="{i:Loc CollectionPage.Tab.SkinsTip}" />
                        <RadioButton x:Name="TabCoins" Style="{StaticResource Tab}" Content="{i:Loc CollectionPage.Tab.Coins}" GroupName="CollectionTab"
                                     IsChecked="{Binding CollectionTabCoins}" ToolTip="{i:Loc CollectionPage.Tab.CoinsTip}" />
                        <RadioButton x:Name="TabBacks" Style="{StaticResource Tab}" Content="{i:Loc CollectionPage.Tab.Backs}" GroupName="CollectionTab"
                                     IsChecked="{Binding CollectionTabBacks}" ToolTip="{i:Loc CollectionPage.Tab.BacksTip}" />
                    </StackPanel>
                </Border>
                <Border x:Name="SetFilter" Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc CollectionPage.Filter.Tip}"
                        Visibility="{Binding CollectionFilterShown, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc CollectionPage.Filter.Standard}" GroupName="CollectionFilter" IsChecked="{Binding CollectionFilterStandard}" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc CollectionPage.Filter.Wild}" GroupName="CollectionFilter" IsChecked="{Binding CollectionFilterWild}"
                                     ToolTip="{i:Loc CollectionPage.Filter.WildTip}" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc CollectionPage.Filter.All}" GroupName="CollectionFilter" IsChecked="{Binding CollectionFilterAll}"
                                     ToolTip="{i:Loc CollectionPage.Filter.AllTip}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The tab's data: read from the game when, or a saved copy with its mark -->
            <ContentControl x:Name="Status" Content="{Binding CollectionPageStatus}" ContentTemplate="{StaticResource LibraryStatusLine}" Focusable="False"
                            Visibility="{Binding HasCollectionPageStatus, Converter={StaticResource Vis}}" />

            <ContentControl x:Name="Empty" Style="{StaticResource EmptyState}" Tag="{Binding CollectionPageEmptyGlyph}" Content="{Binding CollectionPageEmpty}"
                            AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasCollectionPageEmpty, Converter={StaticResource Vis}}" />

            <!-- ===== Expansions: the filter's sum, its bar, then a tile per set (newest first) ===== -->
            <StackPanel x:Name="SetsView" i:Motion.RevealOnShow="True" Visibility="{Binding CollectionSetsShown, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding CollectionSum}" ItemTemplate="{StaticResource CollectionSumTile}" ItemsPanel="{StaticResource StatsTilesPanel}"
                              Margin="0,0,-12,0" Focusable="False" />
                <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Value="{Binding CollectionSumFraction, Mode=OneWay}" Margin="0,4,0,24"
                             Opacity="{Binding CollectionArtOpacity}" AutomationProperties.Name="{i:Loc CollectionPage.Sum.Playable}" />
                <ItemsControl ItemsSource="{Binding CollectionSets}" ItemTemplate="{StaticResource CollectionSetTile}" Margin="0,0,-12,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Hero skins: the classes as chips, the owned count, one class's skins ===== -->
            <StackPanel x:Name="SkinsView" i:Motion.RevealOnShow="True" Visibility="{Binding CollectionSkinsShown, Converter={StaticResource Vis}}">
                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}">
                    <ItemsControl ItemsSource="{Binding CollectionSkinClasses}" ItemsPanel="{StaticResource ChoiceWrap}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                <RadioButton Style="{StaticResource MetaSegment}" Content="{Binding Label}" GroupName="CollectionSkinClass" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding DataContext.SetCollectionSkinClass, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="{Binding CollectionSkinsOwned}" Style="{StaticResource Caption}" Margin="0,8,0,16" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Content="{Binding CollectionSkinGroup}" ContentTemplate="{StaticResource CollectionGroupHead}" Focusable="False" />
                        <ItemsControl ItemsSource="{Binding CollectionSkins}" ItemTemplate="{StaticResource CollectionSkinTile}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Coins: the owned count and its bar, every coin in one card ===== -->
            <StackPanel x:Name="CoinsView" i:Motion.RevealOnShow="True" Visibility="{Binding CollectionCoinsShown, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding CollectionCoinsOwned}" Style="{StaticResource Caption}" />
                <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Value="{Binding CollectionCoinsOwnedFraction, Mode=OneWay}" Margin="0,8,0,16"
                             Opacity="{Binding CollectionArtOpacity}" AutomationProperties.Name="{Binding CollectionCoinsOwned}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding CollectionCoins}" ItemTemplate="{StaticResource CollectionCoinTile}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- ===== Card backs: the owned count and its bar, the groups as chips, one group's backs ===== -->
            <StackPanel x:Name="BacksView" i:Motion.RevealOnShow="True" Visibility="{Binding CollectionBacksShown, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding CollectionBacksOwned}" Style="{StaticResource Caption}" />
                <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Value="{Binding CollectionBacksOwnedFraction, Mode=OneWay}" Margin="0,8,0,16"
                             Opacity="{Binding CollectionArtOpacity}" AutomationProperties.Name="{Binding CollectionBacksOwned}" />
                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding CollectionBackGroups}" ItemsPanel="{StaticResource ChoiceWrap}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:MetaChoice}">
                                <RadioButton Style="{StaticResource MetaSegment}" Content="{Binding Label}" GroupName="CollectionBackGroup" IsChecked="{Binding Selected, Mode=OneWay}"
                                             Command="{Binding DataContext.SetCollectionBackGroup, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Content="{Binding CollectionBackGroup}" ContentTemplate="{StaticResource CollectionGroupHead}" Focusable="False" />
                        <ItemsControl ItemsSource="{Binding CollectionBacks}" ItemTemplate="{StaticResource CollectionBackTile}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
