<UserControl x:Class="Hearthpulse.App.Main.Pages.BattlegroundsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:s="clr-namespace:Hearthpulse.App.Main.Stats"
             xmlns:mm="clr-namespace:Hearthpulse.App.Main.Meta"
             xmlns:dk="clr-namespace:Hearthpulse.App.Main.Decks"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
             xmlns:mg="clr-namespace:Hearthpulse.App.Main.Migration"
             xmlns:cs="clr-namespace:Hearthpulse.Core.Stats;assembly=Hearthpulse.Core">
    <!-- Battlegrounds: community tiers (heroes, comps, trinkets, cards) and the player's own stats, with the bracket picker. Same tree as the Avalonia BattlegroundsPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,0,40,120">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Battlegrounds}" />
                        <TextBlock Text="{i:Loc Main.Mode.Battlegrounds}" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <c:Wave Style="{StaticResource PageRule}" />
                </StackPanel>
                <!-- Solo / Duos: on My stats, and on Heroes when the service has a Duos list. It lies over the head's right
                     side, so hiding it moves nothing. -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Style="{StaticResource SegmentBar}"
                        ToolTip="{i:Loc Main.Bg.ModeTip}" Visibility="{Binding ShowBgMode, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Bg.Solo}" GroupName="BgMode" IsChecked="True" Command="{Binding SetBgMode}" CommandParameter="Battlegrounds" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Main.Mode.Duos}" GroupName="BgMode" Command="{Binding SetBgMode}" CommandParameter="Duos" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- One tab row: My stats first (as Standard and Wild), then the community tier lists; on its right the period
                 (My stats) or the MMR slice (Heroes and Trinkets, whose lists have more than one) -->
            <Grid Margin="0,0,0,14">
                <Border HorizontalAlignment="Left" Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabMine" Style="{StaticResource Tab}" Content="{i:Loc Stats.Title}" GroupName="BgTab" IsChecked="True" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.MyHeroesTip}" />
                        <RadioButton x:Name="TabHeroes" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Heroes}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.HeroesTip}" />
                        <RadioButton x:Name="TabComps" Style="{StaticResource Tab}" Content="{Binding CompTabLabel}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{Binding CompCaption}" />
                        <RadioButton x:Name="TabTrinkets" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Trinkets}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.TrinketsTip}" />
                        <RadioButton x:Name="TabCards" Style="{StaticResource Tab}" Content="{i:Loc Main.Bg.Cards}" GroupName="BgTab" Checked="OnTab"
                                     ToolTip="{i:Loc Main.Bg.CardsCaption}" />
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Stats.Period.Tip}"
                        Visibility="{Binding IsChecked, ElementName=TabMine, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.All}" GroupName="BgPeriod" IsChecked="True" Command="{Binding SetBgPeriod}" CommandParameter="All" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.Week}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Week" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.Month}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Month" />
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Stats.Period.ThisMonth}" GroupName="BgPeriod" Command="{Binding SetBgPeriod}" CommandParameter="Season"
                                     ToolTip="{i:Loc Stats.Period.ThisMonthBgTip}" />
                    </StackPanel>
                </Border>
                <!-- The MMR slices of the open tab's list (heroes: top 50/20/5/1%, in Duos 50/20%; trinkets: the same four);
                     hidden when there is no choice. It lies over the row's right side: showing it moves nothing. -->
                <Grid HorizontalAlignment="Right" Visibility="{Binding HasBracketChoice, Converter={StaticResource Vis}}">
                    <Border x:Name="BracketPicker" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Main.Bg.BracketTip}" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding BracketOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:BracketOption}">
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="Bracket" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding Select}" CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Grid>

            <!-- The own hero statistics of Hearthpulse (metric bg.hero.offer_pick_placement, docs/analytics-api.md): on the
                 Heroes tab above the external tier list, with its own sample and date; a value the pool keeps back reads
                 "not enough data". Hidden without a stats pool and in Duos. Same tree as the Avalonia page. -->
            <Border x:Name="BgOwnCard" Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding ShowBgOwn, Converter={StaticResource Vis}}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Main.BgOwn.Title}" Icon="&#xF0128;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <StackPanel Visibility="{Binding BgOwn.HasRows, Converter={StaticResource Vis}}">
                        <TextBlock x:Name="BgOwnSummary" Text="{Binding BgOwn.Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i:Loc Main.Table.Hero}" Style="{StaticResource TableHead}" />
                            <TextBlock Grid.Column="1" Width="88" TextAlignment="Right" Text="{i:Loc Main.BgOwn.Offered}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.BgOwn.OfferedTip}" />
                            <TextBlock Grid.Column="2" Width="112" TextAlignment="Right" Text="{i:Loc Main.BgOwn.Picked}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.BgOwn.PickedTip}" />
                            <TextBlock Grid.Column="3" Width="124" TextAlignment="Right" Text="{i:Loc Main.Table.PickRate}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.BgOwn.PickRateTip}" />
                            <TextBlock Grid.Column="4" Width="140" TextAlignment="Right" Text="{i:Loc Main.Table.AvgPlacement}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.BgOwn.PlaceTip}" />
                            <TextBlock Grid.Column="5" Width="124" TextAlignment="Right" Text="{i:Loc Main.Table.Top4}" Style="{StaticResource TableHead}" ToolTip="{i:Loc Main.BgOwn.Top4Tip}" />
                        </Grid>
                        <ItemsControl x:Name="BgOwnList" ItemsSource="{Binding BgOwnRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:BgOwnRow}">
                                    <Border Style="{StaticResource RowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Width="88" TextAlignment="Right" Text="{Binding Offered}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Width="112" TextAlignment="Right" Text="{Binding Picked}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Width="124" VerticalAlignment="Center">
                                                <TextBlock TextAlignment="Right" Text="{Binding PickRate}" FontSize="{StaticResource FontSizeLabel}" />
                                                <TextBlock TextAlignment="Right" Text="{Binding PickRange}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Width="140" VerticalAlignment="Center">
                                                <TextBlock TextAlignment="Right" Text="{Binding Place}" FontSize="{StaticResource FontSizeLabel}" />
                                                <TextBlock TextAlignment="Right" Text="{Binding PlaceDetail}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Width="124" VerticalAlignment="Center">
                                                <TextBlock TextAlignment="Right" Text="{Binding Top4}" FontSize="{StaticResource FontSizeLabel}" />
                                                <TextBlock TextAlignment="Right" Text="{Binding Top4Range}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="BgOwnNote" Text="{Binding BgOwn.Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                    <ContentControl x:Name="BgOwnEmpty" Style="{StaticResource EmptyState}" Tag="{Binding BgOwn.EmptyGlyph}" Content="{Binding BgOwn.EmptyText}"
                                    Visibility="{Binding BgOwn.HasRows, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </StackPanel>
            </Border>

            <!-- My stats (Main/Stats): header numbers, MMR over time, hero performance -->
            <s:BattlegroundsStatsView x:Name="BgStats" Visibility="{Binding IsChecked, ElementName=TabMine, Converter={StaticResource Vis}}" />

            <!-- Tier lists (Main/Meta): heroes and trinkets by tier, comps, cards -->
            <mm:BattlegroundsTiersView x:Name="BgTiers" Visibility="{Binding IsChecked, ElementName=TabMine, Converter={StaticResource Vis}, ConverterParameter=!}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
