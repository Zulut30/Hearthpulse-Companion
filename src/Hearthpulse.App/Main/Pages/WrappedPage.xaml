<UserControl x:Class="Hearthpulse.App.Main.Pages.WrappedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The Recap page (docs/wrapped-page.md): the player's month or year from their own games and achievements - one big
         number, the three under it, then a slide each for favourites, modes, when they play, Battlegrounds and achievements.
         Same tree as the Avalonia WrappedPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Pages/LibraryLook.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A slide's leading line: a label over a large value ("Your day" / "Saturday") -->
            <Style x:Key="SlideValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}" />
                <Setter Property="Foreground" Value="{StaticResource StatText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,12" />
            </Style>
            <!-- A number of the hero's three: the value, then what it is, then a detail -->
            <Style x:Key="TrioValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
                <Setter Property="Foreground" Value="{StaticResource StatText}" />
            </Style>
            <Style x:Key="TrioLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeLead}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- A bar of "When you play": the count over it (days only), the bar on a 96 high base, the label under the line -->
            <DataTemplate x:Key="RecapBarTemplate" DataType="{x:Type m:RecapBar}">
                <StackPanel Margin="2,0" Background="Transparent" ToolTip="{Binding Tip}">
                    <!-- The count's line keeps its height with no count (a day without games, every hour): the bases line up -->
                    <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2" MinHeight="16" />
                    <Grid Height="96">
                        <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2,2,1,1" Background="{StaticResource AccentContainer}" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Outline}" />
                    <!-- The label may run past its narrow bar -->
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="-8,4,-8,0" TextAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Top}" Value="True">
                        <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="BarRow">
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,0,40,120">
            <Grid>
                <StackPanel>
                    <!-- The glyph, then the title in the rest of the width: a long title wraps under itself. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Wrapped}" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Wrapped.Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                    </Grid>
                    <c:Wave Style="{StaticResource PageRule}" />
                </StackPanel>
                <!-- Month or year, over the head's right side -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Wrapped.Span.Tip}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SpanMonth" Style="{StaticResource Segment}" Content="{i:Loc Wrapped.Span.Month}" GroupName="WrappedSpan" IsChecked="{Binding WrappedIsMonth, Mode=OneWay}"
                                     Command="{Binding SetWrappedSpan}" CommandParameter="Month" />
                        <RadioButton x:Name="SpanYear" Style="{StaticResource Segment}" Content="{i:Loc Wrapped.Span.Year}" GroupName="WrappedSpan" IsChecked="{Binding WrappedIsYear, Mode=OneWay}"
                                     Command="{Binding SetWrappedSpan}" CommandParameter="Year" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- "Working out your recap…": keeps its room, lit only while a request is being worked out -->
            <StackPanel Orientation="Horizontal" Height="20" Margin="0,0,0,4" IsHitTestVisible="False"
                        i:ContentMotion.Lit="{Binding WrappedComputing}" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="&#xF04E6;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{i:Loc Wrapped.Computing}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- The hero card: the period with its arrows, one big number over a glow, the comparison, then three numbers -->
            <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="32,24" Margin="0,0,0,24" ClipToBounds="True">
                <Grid>
                    <Border Width="160" Height="160" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource MotifBrush}" Opacity="0.5" IsHitTestVisible="False" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xF0141;" Command="{Binding WrappedBack}" IsEnabled="{Binding WrappedCanGoBack}"
                                    ToolTip="{Binding WrappedBackTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding WrappedBackName}" />
                            <TextBlock x:Name="PeriodTitle" Text="{Binding WrappedTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeSubhead}"
                                       Margin="12,0" VerticalAlignment="Center" />
                            <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xF0142;" Command="{Binding WrappedForward}" IsEnabled="{Binding WrappedCanGoForward}"
                                    ToolTip="{Binding WrappedForwardTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding WrappedForwardName}" />
                        </StackPanel>

                        <!-- The first result on its way, nothing in the period, nothing at all, or a failure -->
                        <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF051F;" Content="{i:Loc Wrapped.Computing}"
                                        Visibility="{Binding WrappedFirstComputing, Converter={StaticResource Vis}}" />
                        <ContentControl x:Name="RecapEmpty" Style="{StaticResource EmptyState}" Tag="&#xF00ED;" Content="{Binding WrappedEmpty}" AutomationProperties.LiveSetting="Polite"
                                        Visibility="{Binding WrappedEmptyShown, Converter={StaticResource Vis}}" />
                        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="{Binding WrappedFailed, Converter={StaticResource Vis}}">
                            <TextBlock Text="{i:Loc Wrapped.Error}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Content="{i:Loc Wrapped.Retry}" Command="{Binding RetryWrapped}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="HeroNumbers" i:Motion.RevealOnShow="True" Visibility="{Binding HasRecap, Converter={StaticResource Vis}}">
                            <Grid HorizontalAlignment="Left">
                                <Ellipse Width="360" Height="240" Fill="{StaticResource Glow}" Margin="-120,-80,-120,-80" IsHitTestVisible="False" />
                                <StackPanel>
                                    <!-- Ideal formatting: the window's Display mode draws no glyph this large with a gradient brush -->
                                    <TextBlock x:Name="HeroNumber" Text="{Binding Recap.Number}" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="{StaticResource FontSizeHero}"
                                               Foreground="{StaticResource GildedText}" Margin="0,16,0,0" TextOptions.TextFormattingMode="Ideal" />
                                    <TextBlock Text="{Binding Recap.Caption}" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Background="Transparent" ToolTip="{Binding Recap.DeltaTip}"
                                                Visibility="{Binding Recap.HasDelta, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Recap.DeltaGlyph}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Foreground="{Binding Recap.DeltaSign, Converter={StaticResource SignBrush}}" />
                                        <TextBlock Text="{Binding Recap.Delta}" FontSize="{StaticResource FontSizeLead}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Recap.DeltaSign, Converter={StaticResource SignBrush}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Visibility="{Binding Recap.HasGames, Converter={StaticResource Vis}}">
                                <c:Wave Width="168" HorizontalAlignment="Left" Margin="0,24" IsHitTestVisible="False" />
                                <UniformGrid Rows="1">
                                    <StackPanel Background="Transparent" ToolTip="{Binding Recap.HoursTip}">
                                        <TextBlock Text="{Binding Recap.Hours}" Style="{StaticResource TrioValue}" />
                                        <TextBlock Text="{i:Loc Wrapped.Hours.Label}" Style="{StaticResource TrioLabel}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Recap.WinRate}" Style="{StaticResource TrioValue}" />
                                        <TextBlock Text="{i:Loc Wrapped.WinRate.Label}" Style="{StaticResource TrioLabel}" />
                                        <TextBlock Text="{Binding Recap.WinRateDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Background="Transparent" ToolTip="{i:Loc Wrapped.Streak.Tip}">
                                        <TextBlock Text="{Binding Recap.Streak}" Style="{StaticResource TrioValue}" />
                                        <TextBlock Text="{Binding Recap.StreakLabel}" Style="{StaticResource TrioLabel}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="Slides" i:Motion.RevealOnShow="True" Visibility="{Binding HasRecap, Converter={StaticResource Vis}}">
                <StackPanel Visibility="{Binding Recap.HasGames, Converter={StaticResource Vis}}">
                    <!-- Favourites: class, deck, Battlegrounds hero -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding Recap.HasFavourites, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Wrapped.Fav.Title}" Icon="&#xF02D1;" Size="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Recap.Favourites}" Focusable="False" Margin="0,0,-12,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:RecapTile}">
                                        <Border Style="{StaticResource TileCard}" Padding="16" Margin="0,0,12,0">
                                            <StackPanel>
                                                <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Left" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}"
                                                        BorderThickness="2" i:CardArt.Portrait="{Binding CardId}" c:CardPreview.CardId="{Binding CardId}" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource SlideValue}" Margin="0,4,0,4" MaxHeight="96" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Modes: the most played one, then each mode's games against the most played, time and wins–losses -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Wrapped.Modes.Title}" Icon="&#xF0128;" Size="13" Margin="0,0,0,12" />
                            <TextBlock Text="{i:Loc Wrapped.Modes.Top}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Recap.TopMode}" Style="{StaticResource SlideValue}" />
                            <ItemsControl ItemsSource="{Binding Recap.Modes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:RecapModeRow}">
                                        <Border Style="{StaticResource RowBorder}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <ProgressBar Grid.Column="1" Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Value="{Binding Share, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Games}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Record}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- When you play: the busiest day and hour with their charts, then the longest game -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Wrapped.When.Title}" Icon="&#xF0150;" Size="13" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i:Loc Wrapped.When.Day}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Recap.Day}" Style="{StaticResource SlideValue}" />
                                    <ItemsControl x:Name="DaysChart" ItemsSource="{Binding Recap.Days}" ItemTemplate="{StaticResource RecapBarTemplate}" ItemsPanel="{StaticResource BarRow}" Focusable="False"
                                                  AutomationProperties.Name="{Binding Recap.DaysName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{i:Loc Wrapped.When.Hour}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Recap.Hour}" Style="{StaticResource SlideValue}" />
                                    <ItemsControl ItemsSource="{Binding Recap.HoursOfDay}" ItemTemplate="{StaticResource RecapBarTemplate}" ItemsPanel="{StaticResource BarRow}" Focusable="False"
                                                  AutomationProperties.Name="{Binding Recap.HoursName}" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,16,0,0" Background="Transparent" ToolTip="{i:Loc Wrapped.When.LongestTip}" Visibility="{Binding Recap.HasLongest, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xF0150;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{i:Loc Wrapped.When.Longest}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Recap.Longest}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Recap.LongestDetail}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Battlegrounds solo: games, first places, top 4, average place -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding Recap.HasBattlegrounds, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Main.Mode.Battlegrounds}" Icon="&#xF01A5;" Size="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Recap.Battlegrounds}" Style="{StaticResource StatsTiles}" ItemsPanel="{StaticResource StatsTilesPanel}" />
                            <TextBlock Text="{i:Loc Wrapped.Bg.SoloNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Achievements completed in the period: how many, their points, the latest ten -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Achievements.Title}" Icon="&#xF0538;" Size="13" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Recap.AchievementsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding Recap.HasAchievementsNote, Converter={StaticResource Vis}}" />
                        <StackPanel Visibility="{Binding Recap.HasAchievements, Converter={StaticResource Vis}}">
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Recap.AchievementsCount}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeHeadline}"
                                           Foreground="{StaticResource StatText}" VerticalAlignment="Bottom" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding Recap.AchievementsPoints}" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Recap.Achievements}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:AchievementRecentRow}">
                                        <Border Style="{StaticResource RowBorder}" ToolTip="{Binding Tip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Date}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Points}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Muted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Recap.AchievementsMore}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Visibility="{Binding Recap.HasAchievementsMore, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
