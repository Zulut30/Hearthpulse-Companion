<UserControl x:Class="Hearthpulse.App.Main.Pages.WrappedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The Recap page ("Wrapped"): a month or a year of the player's own games. Same tree as the Avalonia WrappedPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Pages/LibraryLook.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,0,40,120">
            <!-- The glyph, then the title in the rest of the width: a long title wraps under itself. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Wrapped}" />
                <TextBlock Grid.Column="1" Text="{i:Loc Main.Nav.Wrapped}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
            </Grid>
            <c:Wave Style="{StaticResource PageRule}" />
            <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF00ED;" Content="{i:Loc Main.Nav.WrappedTip}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
