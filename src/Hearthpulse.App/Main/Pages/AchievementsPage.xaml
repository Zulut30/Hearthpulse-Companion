<UserControl x:Class="Hearthpulse.App.Main.Pages.AchievementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hearthpulse.App.Main"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- The Achievements page (docs/achievements-page.md): Hearthstone's achievements read from the game - the points,
         the tracked chains with their latest gain, the nearly done and the recent ones, and the whole journal one
         subcategory at a time. Same tree as the Avalonia AchievementsPage.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Pages/LibraryLook.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Meta/MetaResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The star of a chain: lit (accent) while tracked; off at the limit with the reason in its tip. A secret chain
                 not done yet has none (its place stays empty so the names line up), unless it is tracked: then the star
                 stays, so the chain can be let go (AchievementRow.CanStar). -->
            <DataTemplate x:Key="AchievementStar" DataType="{x:Type m:AchievementRow}">
                <Button x:Name="Star" Style="{StaticResource IconButton}" Content="{Binding StarGlyph}" VerticalAlignment="Top"
                        Command="{Binding DataContext.ToggleAchievementStar, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                        IsEnabled="{Binding StarEnabled}" ToolTip="{Binding StarTip}" ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{Binding StarName}" Click="OnStar" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tracked}" Value="True">
                        <Setter TargetName="Star" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CanStar}" Value="False">
                        <Setter TargetName="Star" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A name that stands in for a secret one ("Hidden achievement") is muted -->
            <Style x:Key="ChainName" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Muted}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A tracked chain: star, name, description, level and path; on the right the bar, the progress and the gain -->
            <DataTemplate x:Key="TrackedRow" DataType="{x:Type m:AchievementRow}">
                <Border Style="{StaticResource RowBorder}" MinHeight="56" ToolTip="{Binding Tip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="176" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AchievementStar}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource ChainName}" FontSize="{StaticResource FontSizeLead}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Width="176">
                            <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Height="8" Value="{Binding Share, Mode=OneWay}"
                                         Opacity="{Binding GraphicsOpacity}" Visibility="{Binding ShowsBar, Converter={StaticResource Vis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding Done, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource Accent}"
                                           Opacity="{Binding GraphicsOpacity}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"
                                       Visibility="{Binding Done, Converter={StaticResource Vis}, ConverterParameter=!}" />
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,0"
                                       ToolTip="{i:Loc Achievements.Gain.Tip}" AutomationProperties.Name="{Binding GainLine}">
                                <Run Text="{Binding GainValue, Mode=OneWay}" Foreground="{StaticResource Positive}" FontWeight="SemiBold" /><Run Text="{Binding GainRest, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- A chain close to done: star, name, level and category, a thin bar under them; the share and the progress -->
            <DataTemplate x:Key="NearRow" DataType="{x:Type m:AchievementRow}">
                <Border Style="{StaticResource RowBorder}" ToolTip="{Binding Tip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AchievementStar}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource ChainName}" />
                            <TextBlock Text="{Binding NearDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Height="4" Margin="0,4,0,0" Value="{Binding Share, Mode=OneWay}"
                                         Opacity="{Binding GraphicsOpacity}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Percent}" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- A completed tier: a check, its name (or "Hidden achievement"), where; the date and the points -->
            <DataTemplate x:Key="RecentRow" DataType="{x:Type m:AchievementRecentRow}">
                <Border Style="{StaticResource RowBorder}" ToolTip="{Binding Tip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                   Opacity="{Binding DataContext.AchievementsGraphicsOpacity, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource ChainName}" />
                            <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       Visibility="{Binding Path, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Points}" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- A subcategory in the table of contents: name (two lines at most), completed tiers, a thin bar; the chosen one keeps the plate -->
            <DataTemplate x:Key="SubcategoryRow" DataType="{x:Type m:AchievementSubcategoryRow}">
                <Button Style="{StaticResource ArchetypeRow}" Command="{Binding DataContext.ShowAchievementSubcategory, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Title}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                        <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Top" />
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Height="3" Margin="0,4,0,0"
                                     Value="{Binding Share, Mode=OneWay}" Opacity="{Binding GraphicsOpacity}" />
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,0,40,120">
            <!-- The glyph, then the title in the rest of the width: a long title wraps under itself. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:GoldGlyph Style="{StaticResource PageGlyph}" Glyph="{x:Static c:GameIcons.Achievements}" />
                <TextBlock Grid.Column="1" Text="{i:Loc Achievements.Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            </Grid>
            <c:Wave Style="{StaticResource PageRule}" />

            <!-- Where the numbers come from and of what time; none without a book (the empty state says why) -->
            <ContentControl x:Name="StatusLine" Content="{Binding AchievementsStatusLine}" ContentTemplate="{StaticResource LibraryStatusLine}" Focusable="False"
                            IsTabStop="False" Visibility="{Binding AchievementsStatusLine, Converter={StaticResource Vis}}" />
            <ContentControl x:Name="AchievementsEmptyState" Style="{StaticResource EmptyState}" Tag="{Binding AchievementsEmptyGlyph}" Content="{Binding AchievementsEmpty}"
                            AutomationProperties.LiveSetting="Polite" Visibility="{Binding AchievementsEmptyShown, Converter={StaticResource Vis}}" />
            <!-- Working the book out failed: the empty state above says so, and this tries again -->
            <Button x:Name="RetryAchievementsButton" Style="{StaticResource GhostButton}" Content="{i:Loc Achievements.Retry}" Command="{Binding RetryAchievements}"
                    HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding AchievementsFailed, Converter={StaticResource Vis}}" />

            <StackPanel x:Name="AchievementsContent" i:Motion.RevealOnShow="True" Visibility="{Binding AchievementsShown, Converter={StaticResource Vis}}">
                <!-- The summary: points and completed tiers on the left, the five categories as buttons on the right -->
                <Border x:Name="SummaryCard" Style="{StaticResource Card}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="320" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{i:Loc Achievements.Points}" Style="{StaticResource Label}" />
                            <TextBlock x:Name="PointsEarned" Text="{Binding AchievementSummary.Points}" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold"
                                       FontSize="{StaticResource FontSizeDisplay}" Foreground="{StaticResource GildedText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding AchievementSummary.Of}" Foreground="{StaticResource Muted}" />
                            <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Margin="0,12,0,8" Value="{Binding AchievementSummary.Share, Mode=OneWay}"
                                         Opacity="{Binding AchievementSummary.GraphicsOpacity}" />
                            <TextBlock Text="{Binding AchievementSummary.Completed}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding AchievementSummary.Categories}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:AchievementCategoryRow}">
                                    <Button Style="{StaticResource RowButton}" MinHeight="44" Padding="8,4" Command="{Binding DataContext.ShowAchievementCategory, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}" Click="OnCategory" AutomationProperties.Name="{Binding Name}" ToolTip="{i:Loc Achievements.Category.Tip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" MinWidth="104" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28" Height="28" Opacity="{Binding GraphicsOpacity}">
                                                <c:Scallop Fill="{StaticResource AccentContainer}" Lobes="9" Depth="0.12" />
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="4" Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Height="6" VerticalAlignment="Center"
                                                         Value="{Binding Share, Mode=OneWay}" Opacity="{Binding GraphicsOpacity}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Fraction}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Tracked chains, in the order they were starred -->
                <Border x:Name="TrackedCard" Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <c:Ornament x:Name="TrackedHead" Text="{i:Loc Achievements.Tracked.Title}" Icon="&#xF04CE;" Size="13" HorizontalAlignment="Left"
                                        />
                            <TextBlock Text="{Binding TrackedAchievementsCount}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding TrackedAchievementsFullText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding TrackedAchievementsFull, Converter={StaticResource Vis}}" />
                        <ItemsControl x:Name="TrackedList" ItemsSource="{Binding TrackedAchievementRows}" ItemTemplate="{StaticResource TrackedRow}" Focusable="False" />
                        <TextBlock Text="{Binding TrackedAchievementsMissing}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasTrackedAchievementsMissing, Converter={StaticResource Vis}}" />
                        <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF04D2;" Content="{i:Loc Achievements.Tracked.Empty}"
                                        Visibility="{Binding TrackedAchievementsEmpty, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <!-- Nearly done beside recently completed -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Achievements.Near.Title}" Icon="&#xF012A;" Size="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding NearlyDoneRows}" ItemTemplate="{StaticResource NearRow}" Focusable="False" />
                            <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF012A;" Content="{i:Loc Achievements.Near.Empty}"
                                            Visibility="{Binding NearlyDoneEmpty, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Achievements.Recent.Title}" Icon="&#xF05E0;" Size="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding RecentAchievementRows}" ItemTemplate="{StaticResource RecentRow}" Focusable="False" />
                            <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF05E0;" Content="{i:Loc Achievements.Recent.Empty}"
                                            Visibility="{Binding RecentAchievementsEmpty, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- The whole journal: categories, the chosen category's subcategories, the chosen subcategory's rows -->
                <Border x:Name="BrowseCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Achievements.Browse.Title}" Icon="&#xF0538;" Size="13" Margin="0,0,0,12" />
                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{i:Loc Achievements.Browse.Categories}">
                            <ItemsControl ItemsSource="{Binding AchievementCategories}" ItemsPanel="{StaticResource ChoiceWrap}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:MetaChoice}">
                                        <RadioButton Style="{StaticResource Tab}" Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}" GroupName="AchievementCategory"
                                                     Command="{Binding DataContext.ShowAchievementCategory, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="280" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="Subcategories" ItemsSource="{Binding AchievementSubcategories}" ItemTemplate="{StaticResource SubcategoryRow}" VerticalAlignment="Top"
                                          Focusable="False" AutomationProperties.Name="{i:Loc Achievements.Browse.Subcategories}" />
                            <StackPanel Grid.Column="2">
                                <ItemsControl x:Name="BrowseRows" ItemsSource="{Binding AchievementBrowseRows}" ItemsPanel="{StaticResource PageRows}" Focusable="False">
                                    <ItemsControl.Resources>
                                        <!-- A section's heading: its name and a gold rule to the edge, at the bottom of a row's height -->
                                        <DataTemplate DataType="{x:Type m:AchievementSectionRow}">
                                            <Grid Height="56">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" VerticalAlignment="Bottom" Margin="0,0,12,8" TextTrimming="CharacterEllipsis"
                                                           />
                                                <c:Wave Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,12" IsHitTestVisible="False" />
                                            </Grid>
                                        </DataTemplate>
                                        <!-- A chain: star, name and description, progress and level, points and date -->
                                        <DataTemplate DataType="{x:Type m:AchievementRow}">
                                            <Border Style="{StaticResource RowBorder}" Height="56" ToolTip="{Binding Tip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <!-- Fixed widths: the bars and dates line up from row to row -->
                                                        <ColumnDefinition Width="176" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="104" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AchievementStar}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource ChainName}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Visibility="{Binding Secret, Converter={StaticResource Vis}, ConverterParameter=!}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <ProgressBar Style="{StaticResource ShareBar}" Foreground="{StaticResource Accent}" Width="56" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                         Value="{Binding Share, Mode=OneWay}" Opacity="{Binding GraphicsOpacity}" Visibility="{Binding ShowsBar, Converter={StaticResource Vis}}" />
                                                            <TextBlock Text="&#xF05E0;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Accent}" Margin="0,0,4,0"
                                                                       VerticalAlignment="Center" Opacity="{Binding GraphicsOpacity}" Visibility="{Binding Done, Converter={StaticResource Vis}}" />
                                                            <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Level}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Visibility="{Binding Secret, Converter={StaticResource Vis}, ConverterParameter=!}">
                                                        <TextBlock Text="{Binding Points}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF0538;" Content="{i:Loc Achievements.Browse.Empty}"
                                                Visibility="{Binding AchievementBrowseEmpty, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
