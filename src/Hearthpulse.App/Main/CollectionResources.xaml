<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Hearthpulse.App.Main"
                    xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure">
    <!-- What the meta view and the deck page share of the collection; each merges it, so it is found when the view is
         built on its own. Theme tokens only; the Avalonia twin is Main/CollectionResources.axaml. -->
    <i:VisibleWhen x:Key="Vis" />

    <!-- The player's collection (docs/collection.md): a deck's build label, a glyph and words, dimmed by a saved
         collection; one missing card; and the reason, the missing cards and the sum behind a label. -->
    <Style x:Key="DeckBuildButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Transparent, not null: the whole 24 px of the label takes the click, not only its glyphs -->
                    <Border Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="DeckBuildLabel" DataType="{x:Type m:DeckBuildView}">
        <DockPanel Opacity="{Binding Opacity}">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" TextWrapping="Wrap" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="MissingCardTemplate" DataType="{x:Type m:MissingCardRow}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Price}" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Top" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DeckMissingList" DataType="{x:Type m:DeckBuildView}">
        <StackPanel>
            <TextBlock Text="{Binding Tip}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasTip, Converter={StaticResource Vis}}" />
            <TextBlock Text="{i:Loc Collection.Missing.Title}" Style="{StaticResource Label}" FontSize="11.5" Margin="0,0,0,4" Visibility="{Binding HasMissing, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource MissingCardTemplate}" Focusable="False" />
            <TextBlock Text="{Binding Total}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Total, Converter={StaticResource Vis}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
