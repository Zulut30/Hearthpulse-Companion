<UserControl x:Class="Hearthpulse.App.Main.Cards.CardPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:k="clr-namespace:Hearthpulse.App.Main.Cards"
             xmlns:m="clr-namespace:Hearthpulse.App.Main">
    <!-- The card page: one Constructed card (docs/card-page.md). DataContext is MainViewModel.CardPage. Colours are theme tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hearthpulse;component/Main/MainPages.xaml" />
                <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A number of the card: label, gold rule, value, what it is counted from. The texts wrap: nothing is cut. -->
            <DataTemplate x:Key="CardTile" DataType="{x:Type m:StatTile}">
                <Border Style="{DynamicResource TileCard}" Padding="16,12,16,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        <Border Width="22" Height="2" CornerRadius="1" Background="{StaticResource AccentLine}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource Stat}" FontSize="{StaticResource FontSizeHeadline}" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Sign}" Value="1">
                        <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Positive}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Sign}" Value="-1">
                        <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Negative}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A column head: wraps instead of trimming, numbers' heads sit right like their numbers -->
            <Style x:Key="CardHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
            <Style x:Key="CardNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: back, the card as the game draws it, name, cost / class / set / format, text -->
        <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Command="{Binding Back}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="12,8"
                ToolTip="{i:Loc Card.BackTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF004D;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,4,0" />
                <TextBlock Text="{i:Loc Card.Back}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The frame keeps the card's room while its art loads (or is missing), so the name does not jump -->
            <Grid x:Name="CardFrame" Width="200" Height="290" VerticalAlignment="Top">
                <Image x:Name="CardImage" Stretch="Uniform" i:CardArt.Card="{Binding CardId}" AutomationProperties.Name="{Binding Name}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="CardName" Text="{Binding Name}" Style="{StaticResource Display}" FontSize="{StaticResource FontSizeDisplay}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{StaticResource Surface4}" Padding="8,2" Margin="0,0,8,8">
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CardText" Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0"
                           Visibility="{Binding Text, Converter={StaticResource Vis}}" />
                <TextBlock Text="{i:Loc Card.Loading}" Style="{StaticResource Caption}" Margin="0,12,0,0"
                           Visibility="{Binding Loading, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Grid>

        <!-- The card in ranked games: what the source gives, with its slice and date -->
        <Border x:Name="StatsCard" Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Stats.Title}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource CardTile}" ItemsPanel="{StaticResource StatsTilesPanel3}" Margin="0,0,-12,0"
                              Focusable="False" />
                <TextBlock x:Name="StatsSource" Text="{Binding StatsSource}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Visibility="{Binding StatsSource, Converter={StaticResource Vis}}" />
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF012A;" Content="{Binding StatsEmpty}"
                                Visibility="{Binding StatsEmpty, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>

        <!-- Archetypes of the loaded meta whose lists run the card -->
        <Border x:Name="ArchetypesCard" Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Archetypes.Title}" Icon="&#xF0639;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <StackPanel Visibility="{Binding Archetypes, Converter={StaticResource Vis}}">
                    <Grid Margin="-2,0,-2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{i:Loc Card.Col.Archetype}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Card.Col.Lists}" Style="{StaticResource CardHead}" ToolTip="{i:Loc Card.Col.ListsTip}" />
                        <TextBlock Grid.Column="2" Text="{i:Loc Card.Col.Copies}" Style="{StaticResource CardHead}" ToolTip="{i:Loc Card.Col.CopiesTip}" />
                        <TextBlock Grid.Column="3" Text="{i:Loc Card.Col.WinRate}" Style="{StaticResource CardHead}" ToolTip="{i:Loc Card.Col.WinRateTip}" />
                        <TextBlock Grid.Column="4" Text="{i:Loc Card.Col.Games}" Style="{StaticResource CardHead}" />
                    </Grid>
                    <ItemsControl x:Name="ArchetypeRows" ItemsSource="{Binding Archetypes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type k:CardArchetypeRow}">
                                <Border Style="{StaticResource RowBorder}" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Style="{StaticResource StatsPortrait}" HorizontalAlignment="Left" i:CardArt.Portrait="{Binding HeroId}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ClassName}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Share}" FontWeight="Bold" TextAlignment="Right" />
                                            <TextBlock Text="{Binding Lists}" Style="{StaticResource Caption}" TextAlignment="Right" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Copies}" Style="{StaticResource CardNumber}" />
                                        <TextBlock Grid.Column="4" Text="{Binding WinRate}" Style="{StaticResource CardNumber}" FontWeight="Bold"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Games}" Style="{StaticResource CardNumber}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MetaSource}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding MetaSource, Converter={StaticResource Vis}}" />
                </StackPanel>
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF0639;" Content="{Binding ArchetypesEmpty}"
                                Visibility="{Binding ArchetypesEmpty, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>

        <!-- The card in each archetype's opening hand -->
        <Border x:Name="MulliganCard" Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Mulligan.Title}" Icon="&#xF012C;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <StackPanel Visibility="{Binding Mulligan, Converter={StaticResource Vis}}">
                    <Grid Margin="-2,0,-2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{i:Loc Card.Col.Archetype}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Card.Col.Keep}" Style="{StaticResource CardHead}" ToolTip="{i:Loc Card.Col.KeepTip}" />
                        <TextBlock Grid.Column="2" Text="{i:Loc Card.Col.HandWinRate}" Style="{StaticResource CardHead}" ToolTip="{i:Loc Card.Col.HandWinRateTip}" />
                        <TextBlock Grid.Column="3" Text="{i:Loc Card.Col.Impact}" Style="{StaticResource CardHead}" ToolTip="{i:Loc Card.Col.ImpactTip}" />
                        <TextBlock Grid.Column="4" Text="{i:Loc Card.Col.Hands}" Style="{StaticResource CardHead}" />
                    </Grid>
                    <ItemsControl x:Name="MulliganRows" ItemsSource="{Binding Mulligan}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type k:CardMulliganRow}">
                                <Border Style="{StaticResource RowBorder}" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Style="{StaticResource StatsPortrait}" HorizontalAlignment="Left" i:CardArt.Portrait="{Binding HeroId}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ClassName}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding KeepRate}" Style="{StaticResource CardNumber}" />
                                        <TextBlock Grid.Column="3" Text="{Binding WinRate}" Style="{StaticResource CardNumber}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Impact}" Style="{StaticResource CardNumber}" FontWeight="Bold"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Hands}" Style="{StaticResource CardNumber}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MetaSource}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding MetaSource, Converter={StaticResource Vis}}" />
                </StackPanel>
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF012C;" Content="{Binding MulliganEmpty}"
                                Visibility="{Binding MulliganEmpty, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>

        <!-- The player's own games with the card: local history only -->
        <Border x:Name="MineCard" Style="{StaticResource Card}">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Mine.Title}" Icon="&#xF02DA;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding MineTiles}" ItemTemplate="{StaticResource CardTile}" ItemsPanel="{StaticResource StatsTilesPanel3}" Margin="0,0,-12,0"
                              Focusable="False" />
                <TextBlock Text="{Binding MineNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Visibility="{Binding MineNote, Converter={StaticResource Vis}}" />
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF0004;" Content="{Binding MineEmpty}"
                                Visibility="{Binding MineEmpty, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
