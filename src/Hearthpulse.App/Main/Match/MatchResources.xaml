<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Hearthpulse.App.Controls"
                    xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
                    xmlns:r="clr-namespace:Hearthpulse.Core.Replay;assembly=Hearthpulse.Core"
                    xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match">
    <!-- Templates, styles and converters of the match page (MatchView.xaml merges this dictionary). Theme tokens only;
         the Avalonia twins are in Main/Match/MatchResources.axaml and MatchStyles.axaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Hearthpulse;component/Main/Stats/StatsResources.xaml" />
        <!-- Page title rule and empty states (the window's copy is not visible while this view is parsed) -->
        <ResourceDictionary Source="/Hearthpulse;component/Main/MainLook.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- A card back: the card's shape in the theme, used for every card the game never showed -->
    <ControlTemplate x:Key="CardBack" TargetType="ContentControl">
        <Border CornerRadius="8" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2">
            <Border Margin="4" CornerRadius="5" Background="{StaticResource Decor}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <c:Scallop Width="40" Height="40" Fill="{StaticResource Surface4}" Lobes="9" Depth="0.12" />
                    <TextBlock Text="&#xF0639;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource GoldTrim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Border>
    </ControlTemplate>

    <!-- An entry of the "Turn" list (and the list's face): a marker in the stretch's colour, then its name; the
         stretch's full caption on hover (MatchTimelineLayout.MarkerBrush) -->
    <DataTemplate x:Key="JumpItem" DataType="{x:Type mt:MatchJumpRow}">
        <DockPanel ToolTip="{Binding Tooltip}" Background="Transparent">
            <Border x:Name="Marker" DockPanel.Dock="Left" Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Look}" Value="Mine">
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Look}" Value="Theirs">
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Accent2}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Look}" Value="Won">
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Look}" Value="Lost">
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Negative}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The "Bookmarks" menu: the theme's context menu with a scroll (a long game may hold many bookmarks) -->
    <Style x:Key="BookmarkMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="160">
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Under a card render while it loads (or when it cannot): the card body with its name -->
    <ControlTemplate x:Key="CardPlaceholder" TargetType="ContentControl">
        <Border CornerRadius="6" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="4"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>

    <!-- A minion or location on the board: the full card render, the current attack and health over the printed
         ones, a divine shield halo; the full card shows on hover. Plan R2: the step's actor glows in a frame of
         its side's colour (a sword badge when it attacks), an attack target is framed in Negative, a play's
         target dashed; the health it gained or lost on the step sits over the art; one that died on the step
         fades under a skull. Whose step and what kind come from the page's Table (MatchArrowLayer draws the arrow).
         The card is a MatchCardItem: the same object from step to step, so a step changes its bindings, not its row. -->
    <DataTemplate x:Key="Minion" DataType="{x:Type mt:MatchCardItem}">
        <StackPanel Width="86" Margin="2,0" ToolTip="{Binding Tooltip}">
            <Grid Height="129" Background="Transparent" c:CardPreview.CardId="{Binding CardId}" mt:MatchArrowLayer.Ref="{Binding Ref}" mt:MatchArrowLayer.Anchor="Minion">
                <Ellipse x:Name="Halo" Margin="-6,-2,-6,10" Fill="{StaticResource Glow}" Visibility="Collapsed" />
                <Grid x:Name="Body">
                    <Border Margin="1,6,1,2" CornerRadius="10" BorderBrush="{StaticResource Info}" BorderThickness="2.5" Opacity="0.85"
                            Visibility="{Binding DivineShield, Converter={StaticResource Vis}}" />
                    <ContentControl Template="{StaticResource CardPlaceholder}" Margin="6,10,6,6" />
                    <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,103,0,0" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Attack}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,103,0,0" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                        <TextBlock x:Name="Hp" Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Border x:Name="Frame" Margin="-2,3,-2,-1" CornerRadius="11" BorderThickness="2.5" BorderBrush="{StaticResource Accent2}"
                        Visibility="Collapsed" ToolTip="{i:Loc Match.Mark.Actor}" />
                <Rectangle x:Name="Aim" Margin="-2,3,-2,-1" RadiusX="11" RadiusY="11" StrokeThickness="2" StrokeDashArray="3,2" Stroke="{StaticResource Accent2}"
                           Visibility="Collapsed" />
                <TextBlock x:Name="Skull" Text="&#xF0BC8;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeHeadline}" Foreground="{StaticResource Negative}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0" Visibility="Collapsed" />
                <Border x:Name="Badge" Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Accent2}" BorderThickness="1"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Accent2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border MinWidth="30" Height="22" CornerRadius="11" Padding="6,0" BorderThickness="1.5" Background="{StaticResource OverlayBadgeShade}"
                        BorderBrush="{Binding Change, Converter={StaticResource SignBrush}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"
                        ToolTip="{Binding ChangeTip}" AutomationProperties.Name="{Binding ChangeTip}" Visibility="{Binding ChangeText, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding ChangeText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{Binding Change, Converter={StaticResource SignBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Damaged}" Value="True">
                <Setter TargetName="Hp" Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
            <!-- The step's actor: the glow and the frame; your step in the accent -->
            <DataTrigger Binding="{Binding Acting}" Value="True">
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Acting}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Frame" Property="ToolTip" Value="{i:Loc Match.Mark.Attacker}" />
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="ToolTip" Value="{i:Loc Match.Mark.Attacker}" />
                <Setter TargetName="Badge" Property="AutomationProperties.Name" Value="{i:Loc Match.Mark.Attacker}" />
                <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xF04E5;" />
            </MultiDataTrigger>
            <!-- A play's target: the dashed frame and the auto-fix badge in the side's colour -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Targeted}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Aim" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="ToolTip" Value="{i:Loc Match.Mark.PlayTarget}" />
                <Setter TargetName="Badge" Property="AutomationProperties.Name" Value="{i:Loc Match.Mark.PlayTarget}" />
                <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xF0068;" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding DataContext.Table.LocalActs, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Aim" Property="Stroke" Value="{StaticResource Accent}" />
                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <!-- An attack's target: the frame in Negative, the target badge -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Targeted}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Negative}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="3" />
                <Setter TargetName="Frame" Property="ToolTip" Value="{i:Loc Match.Mark.AttackTarget}" />
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Negative}" />
                <Setter TargetName="Badge" Property="ToolTip" Value="{i:Loc Match.Mark.AttackTarget}" />
                <Setter TargetName="Badge" Property="AutomationProperties.Name" Value="{i:Loc Match.Mark.AttackTarget}" />
                <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xF04FE;" />
                <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{StaticResource Negative}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Dying}" Value="True">
                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                <Setter TargetName="Skull" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A card in hand: the full card render (cost and text as in the game), or a card back with how it got there.
         A card the log revealed later in the game is face up with an eye mark and the turn it was revealed. -->
    <DataTemplate x:Key="HandCard" DataType="{x:Type mt:MatchCardItem}">
        <StackPanel Width="66" Margin="1,0" ToolTip="{Binding Tooltip}">
            <Grid Height="100">
                <Grid x:Name="Face" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                    <ContentControl Template="{StaticResource CardPlaceholder}" Margin="4,8,4,4" />
                    <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                </Grid>
                <ContentControl x:Name="Back" Template="{StaticResource CardBack}" Margin="4,8,4,4" Visibility="Collapsed" />
                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentContainer}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{Binding Revealed, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xF06D0;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource OnAccentContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,1,0,0" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding CardBack}" Value="True">
                <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Back" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Revealed}" Value="True">
                <Setter TargetName="NoteText" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A card offered at a choice (Discover, mulligan): the render, the picked/kept one framed, the others dimmed -->
    <DataTemplate x:Key="ChoiceCard" DataType="{x:Type r:MatchCardView}">
        <StackPanel x:Name="Root" Width="92" Margin="3,0" ToolTip="{Binding Tooltip}">
            <Grid Height="138">
                <Border x:Name="Frame" Margin="2,8,2,3" CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="2.5" Visibility="Collapsed" />
                <Grid x:Name="Face" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
                    <ContentControl Template="{StaticResource CardPlaceholder}" Margin="6,11,6,6" />
                    <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
                </Grid>
                <ContentControl x:Name="Back" Template="{StaticResource CardBack}" Margin="6,11,6,6" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding CardBack}" Value="True">
                <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Back" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Picked}" Value="True">
                <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                <Setter TargetName="NoteText" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Dimmed}" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A Battlegrounds hero offered at the start: a round portrait (as the hero line and the leaderboard) with the
         name under it; the picked one ringed in the accent, the others dimmed. No card frame, no cost. -->
    <DataTemplate x:Key="HeroChoiceCard" DataType="{x:Type r:MatchCardView}">
        <StackPanel x:Name="Root" Width="124" Margin="2,0" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding ChoiceName}" Background="Transparent"
                    c:CardPreview.CardId="{Binding CardId}">
            <Grid Width="72" Height="72" HorizontalAlignment="Center">
                <Ellipse x:Name="Ring" StrokeThickness="3" Stroke="{StaticResource Accent}" Visibility="Collapsed" />
                <Border Margin="5" CornerRadius="31" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                        i:CardArt.Portrait="{Binding CardId}" />
            </Grid>
            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineStackingStrategy="BlockLineHeight" LineHeight="16" Margin="0,4,0,0" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Picked}" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Dimmed}" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="ChoicePanel">
        <WrapPanel HorizontalAlignment="Center" />
    </ItemsPanelTemplate>

    <!-- A choice row: its title, then the offered cards (the hero choice: hero portraits) -->
    <DataTemplate x:Key="ChoiceRow" DataType="{x:Type r:MatchChoiceView}">
        <StackPanel Margin="0,4,0,6">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Cards}" ItemsPanel="{StaticResource ChoicePanel}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource ChoiceCard}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHero}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource HeroChoiceCard}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- A small round card (weapon, hero power, secret); plan R2: a ring when it acts or is aimed at, as a minion's frame -->
    <DataTemplate x:Key="Chip" DataType="{x:Type mt:MatchCardItem}">
        <Grid Width="40" Height="40" Margin="4,0,0,0" ToolTip="{Binding Tooltip}" Background="Transparent" c:CardPreview.CardId="{Binding CardId}"
              mt:MatchArrowLayer.Ref="{Binding Ref}" mt:MatchArrowLayer.Anchor="Chip">
            <Ellipse x:Name="Ring" Margin="-3" StrokeThickness="2" Stroke="{StaticResource Accent2}" Visibility="Collapsed" />
            <Border x:Name="Face" CornerRadius="20" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5" i:CardArt.Portrait="{Binding CardId}" />
            <Border x:Name="Back" CornerRadius="20" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Visibility="Collapsed">
                <TextBlock Text="?" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Attack}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="-2,0,0,-4" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,-2,-4" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding CardBack}" Value="True">
                <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Back" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Acting}" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Targeted}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="StrokeDashArray" Value="3,2" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding DataContext.Table.LocalActs, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Targeted}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Negative}" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A side's hero line: portrait with health, weapon, hero power, secrets, mana and deck -->
    <DataTemplate x:Key="HeroLine" DataType="{x:Type mt:MatchTableSide}">
        <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <ItemsControl ItemsSource="{Binding Secrets}" ItemTemplate="{StaticResource Chip}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ContentControl Content="{Binding Weapon}" ContentTemplate="{StaticResource Chip}" Visibility="{Binding Weapon, Converter={StaticResource Vis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Plan R2: the portrait glows and is ringed when the hero acts or is aimed at, with its health change -->
                <Grid Width="62" Height="62" ToolTip="{Binding Hero}" mt:MatchArrowLayer.Ref="{Binding HeroRef}" mt:MatchArrowLayer.Anchor="Hero">
                    <Ellipse x:Name="HeroHalo" Margin="-10" Fill="{StaticResource Glow}" Visibility="Collapsed" />
                    <Ellipse x:Name="HeroRing" Margin="-4" StrokeThickness="2.5" Stroke="{StaticResource Accent2}" Visibility="Collapsed" />
                    <Border CornerRadius="31" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2" i:CardArt.Portrait="{Binding HeroCardId}" />
                    <!-- Health by a heart and armor by a shield, apart (as on the Battlegrounds table): "30 + 5" read as a sum -->
                    <Border CornerRadius="9" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" Padding="5,1,6,1"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-40,0,-40,-8" ToolTip="{Binding HealthTip}"
                            AutomationProperties.Name="{Binding HealthTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF02D1;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Negative}" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock Text="{Binding HealthText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xF0498;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,2,0"
                                       Visibility="{Binding ArmorText, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding ArmorText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                                       Visibility="{Binding ArmorText, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="HeroBadge" Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Accent2}" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,-6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="HeroBadgeGlyph" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Accent2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border MinWidth="30" Height="22" CornerRadius="11" Padding="6,0" BorderThickness="1.5" Background="{StaticResource OverlayBadgeShade}"
                            BorderBrush="{Binding HealthChange, Converter={StaticResource SignBrush}}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-12,0"
                            ToolTip="{Binding HealthChangeTip}" AutomationProperties.Name="{Binding HealthChangeTip}"
                            Visibility="{Binding HealthChangeText, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding HealthChangeText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{Binding HealthChange, Converter={StaticResource SignBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ContentControl Content="{Binding HeroPower}" ContentTemplate="{StaticResource Chip}" Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HeroPower, Converter={StaticResource Vis}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                <WrapPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}" Margin="0,2,0,2" ToolTip="{i:Loc Match.View.ManaTip}">
                        <StackPanel Orientation="Horizontal">
                            <c:ManaCost Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Mana}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <!-- Plan R2: deck, hand and Secrets as counters (the Secrets at zero too: one width for both sides) -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding DeckTip}" AutomationProperties.Name="{Binding DeckTip}">
                        <TextBlock Text="&#xF0639;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <TextBlock Text="{Binding DeckCount}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="10,0,0,0" ToolTip="{Binding HandTip}" AutomationProperties.Name="{Binding HandTip}">
                        <TextBlock Text="&#xF0E47;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <TextBlock Text="{Binding HandCount}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="10,0,0,0" ToolTip="{Binding SecretTip}" AutomationProperties.Name="{Binding SecretTip}">
                        <TextBlock Text="&#xF078B;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <TextBlock Text="{Binding SecretCount}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HeroActing}" Value="True">
                <Setter TargetName="HeroHalo" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeroRing" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HeroActing}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HeroBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeroBadge" Property="ToolTip" Value="{i:Loc Match.Mark.Attacker}" />
                <Setter TargetName="HeroBadge" Property="AutomationProperties.Name" Value="{i:Loc Match.Mark.Attacker}" />
                <Setter TargetName="HeroBadgeGlyph" Property="Text" Value="&#xF04E5;" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HeroTargeted}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HeroRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeroRing" Property="StrokeThickness" Value="2" />
                <Setter TargetName="HeroRing" Property="StrokeDashArray" Value="3,2" />
                <Setter TargetName="HeroBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeroBadge" Property="ToolTip" Value="{i:Loc Match.Mark.PlayTarget}" />
                <Setter TargetName="HeroBadge" Property="AutomationProperties.Name" Value="{i:Loc Match.Mark.PlayTarget}" />
                <Setter TargetName="HeroBadgeGlyph" Property="Text" Value="&#xF0068;" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding DataContext.Table.LocalActs, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter TargetName="HeroRing" Property="Stroke" Value="{StaticResource Accent}" />
                <Setter TargetName="HeroBadge" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="HeroBadgeGlyph" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HeroTargeted}" Value="True" />
                    <Condition Binding="{Binding DataContext.Table.IsAttack, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HeroRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeroRing" Property="StrokeThickness" Value="3" />
                <Setter TargetName="HeroRing" Property="Stroke" Value="{StaticResource Negative}" />
                <Setter TargetName="HeroBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeroBadge" Property="BorderBrush" Value="{StaticResource Negative}" />
                <Setter TargetName="HeroBadge" Property="ToolTip" Value="{i:Loc Match.Mark.AttackTarget}" />
                <Setter TargetName="HeroBadge" Property="AutomationProperties.Name" Value="{i:Loc Match.Mark.AttackTarget}" />
                <Setter TargetName="HeroBadgeGlyph" Property="Text" Value="&#xF04FE;" />
                <Setter TargetName="HeroBadgeGlyph" Property="Foreground" Value="{StaticResource Negative}" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="CardRow">
        <WrapPanel HorizontalAlignment="Center" />
    </ItemsPanelTemplate>

    <!-- An action of the turn: clicking it shows its step. Your actions carry the gold accent, the opponent's the
         second accent (edge + icon disc); a key card's biggest swing is starred, with why in the tooltip. -->
    <DataTemplate x:Key="ActionRow" DataType="{x:Type mt:MatchActionItem}">
        <Button x:Name="Row" Style="{StaticResource RowButton}" Padding="10,6" Margin="0,0,0,3"
                Command="{Binding DataContext.GoFrame, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
            <Grid>
                <Border x:Name="Mark" CornerRadius="8" Margin="-10,-6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
                <Border x:Name="Edge" Width="3" CornerRadius="1.5" Margin="-10,-2,0,-2" HorizontalAlignment="Left" Background="{StaticResource Accent2Line}" />
                <DockPanel Margin="2,0,0,0">
                    <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Border x:Name="Disc" CornerRadius="13" Background="{StaticResource Accent2Soft}" />
                        <TextBlock x:Name="Glyph" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Accent2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="Star" DockPanel.Dock="Right" Text="&#xF04CE;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Top" Margin="6,5,0,0" Visibility="Collapsed" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Local}" Value="True">
                <Setter TargetName="Edge" Property="Background" Value="{StaticResource AccentLine}" />
                <Setter TargetName="Disc" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Key}" Value="True">
                <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="ToolTip" Value="{Binding KeyReason}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Current}" Value="True">
                <Setter TargetName="Mark" Property="Background" Value="{StaticResource SelectedFill}" />
                <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A row of the game's event feed (plan R2): a turn's header (a marker in the turn's colour, its text, a rule; the
         turn on screen in the text colour; a click goes to its first step), or an action as the turn's action row.
         Neither takes the focus: the player keeps its keys. -->
    <DataTemplate x:Key="FeedRow" DataType="{x:Type mt:MatchFeedItem}">
        <Grid>
            <Button x:Name="HeaderRow" Style="{StaticResource RowButton}" Focusable="False" Padding="2,0" Height="26" Margin="0,10,0,4" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.GoFrame, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="{Binding Text}" AutomationProperties.Name="{Binding Text}" Visibility="Collapsed">
                <DockPanel>
                    <Border x:Name="Marker" DockPanel.Dock="Left" Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource Accent2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderText" DockPanel.Dock="Left" Text="{Binding Text}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                               Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Height="1" Background="{StaticResource Border}" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button x:Name="Row" Style="{StaticResource RowButton}" Focusable="False" Padding="10,6" Margin="0,0,0,3"
                    Command="{Binding DataContext.GoFrame, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Text}">
                <Grid>
                    <Border x:Name="Mark" CornerRadius="8" Margin="-10,-6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
                    <Border x:Name="Edge" Width="3" CornerRadius="1.5" Margin="-10,-2,0,-2" HorizontalAlignment="Left" Background="{StaticResource Accent2Line}" />
                    <DockPanel Margin="2,0,0,0">
                        <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Border x:Name="Disc" CornerRadius="13" Background="{StaticResource Accent2Soft}" />
                            <TextBlock x:Name="Glyph" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Accent2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="Star" DockPanel.Dock="Right" Text="&#xF04CE;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Top" Margin="6,5,0,0" Visibility="Collapsed" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Button>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Local}" Value="True">
                <Setter TargetName="Edge" Property="Background" Value="{StaticResource AccentLine}" />
                <Setter TargetName="Disc" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mulligan}" Value="True">
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Muted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Key}" Value="True">
                <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="ToolTip" Value="{Binding KeyReason}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Current}" Value="True">
                <Setter TargetName="Mark" Property="Background" Value="{StaticResource SelectedFill}" />
                <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource SelectedEdge}" />
                <Setter TargetName="HeaderText" Property="Foreground" Value="{StaticResource Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Header}" Value="True">
                <Setter TargetName="HeaderRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!-- The first header (the game's first step) without the gap over it -->
            <DataTrigger Binding="{Binding Frame}" Value="0">
                <Setter TargetName="HeaderRow" Property="Margin" Value="0,0,0,4" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A deck list row as in the overlay's deck: cost gem, the card's tile art behind its name, the rarity edge, copies; the note
         (drawn, played, revealed...) under it; the full card shows on hover -->
    <DataTemplate x:Key="DeckRow" DataType="{x:Type r:MatchDeckRow}">
        <StackPanel x:Name="Root" Margin="0,0,0,5" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="31" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:ManaCost Width="25" Height="25" Text="{Binding Cost}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{StaticResource Row}" CornerRadius="5" c:RoundClip.Radius="5">
                    <Grid>
                        <Image i:CardArt.Tile="{Binding CardId}" Width="140" HorizontalAlignment="Right" Stretch="UniformToFill" />
                        <Rectangle Fill="{StaticResource TileFade}" />
                        <Border Width="3" HorizontalAlignment="Left" Background="{Binding Rarity, Converter={StaticResource KeyBrush}}"
                                Visibility="{Binding Rarity, Converter={StaticResource Vis}}" />
                        <DockPanel Margin="10,0,4,0">
                            <Border DockPanel.Dock="Right" Background="{StaticResource OverlayBadgeShade}" CornerRadius="4" MinWidth="26" Height="21" Padding="5,0"
                                    Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Count}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLead}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeSmall}" Margin="31,2,0,0" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding Note, Converter={StaticResource Vis}}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Used}" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A Battlegrounds minion (round art with stats) -->
    <DataTemplate x:Key="BgMinion" DataType="{x:Type r:MatchCardView}">
        <Grid Width="52" Height="60" Margin="2,0" ToolTip="{Binding Tooltip}">
            <Border x:Name="Art" Width="48" Height="56" CornerRadius="24" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Top" i:CardArt.Portrait="{Binding CardId}" />
            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Attack}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Surface3}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Golden}" Value="True">
                <Setter TargetName="Art" Property="BorderBrush" Value="{StaticResource Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Wrap">
        <WrapPanel />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="RowPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- A minion of the Battlegrounds table (our board, Bob's offer, the combat opponent's board): the round art
         with a rim for its state, the offer's tier and the step's badge on top, attack and health, keyword glyphs
         under it. The card the step is about glows; one dying in the step fades under a skull. -->
    <DataTemplate x:Key="BgBoardMinion" DataType="{x:Type mt:MatchBgCardItem}">
        <Grid x:Name="Cell" Width="70" Height="96" Margin="2,0" ToolTip="{Binding Tooltip}" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
            <Grid Width="64" Height="76" VerticalAlignment="Top" Margin="0,2,0,0">
                <Ellipse x:Name="Halo" Margin="-3,-4" Fill="{StaticResource Glow}" Visibility="Collapsed" />
                <Border Margin="-3" CornerRadius="35" BorderBrush="{StaticResource Info}" BorderThickness="2.5" Opacity="0.85"
                        Visibility="{Binding DivineShield, Converter={StaticResource Vis}}" />
                <Border x:Name="Oval" CornerRadius="32" Background="{StaticResource Surface4}" BorderBrush="{StaticResource Border}" BorderThickness="2"
                        i:CardArt.Portrait="{Binding CardId}" />
                <TextBlock x:Name="Skull" Text="&#xF0BC8;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeHeadline}" Foreground="{StaticResource Negative}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource Surface3}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="{Binding Tier, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Badge" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,58,0,0" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Attack}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,0,0" Visibility="{Binding ShowStats, Converter={StaticResource Vis}}">
                <TextBlock x:Name="Hp" Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Orientation="Horizontal" Height="14" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <TextBlock Text="&#xF006A;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="1,0" Visibility="{Binding Reborn, Converter={StaticResource Vis}}" />
                <TextBlock Text="&#xF1133;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="1,0" Visibility="{Binding Venomous, Converter={StaticResource Vis}}" />
                <TextBlock Text="&#xF059D;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="1,0" Visibility="{Binding Windfury, Converter={StaticResource Vis}}" />
                <TextBlock Text="&#xF06D1;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" Margin="1,0" Visibility="{Binding Stealth, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Grid>
        <!-- Later triggers win: the step's state over golden over taunt -->
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Damaged}" Value="True">
                <Setter TargetName="Hp" Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Taunt}" Value="True">
                <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource Muted}" />
                <Setter TargetName="Oval" Property="BorderThickness" Value="4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Golden}" Value="True">
                <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Oval" Property="BorderThickness" Value="2.5" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Golden}" Value="True" />
                    <Condition Binding="{Binding Taunt}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Oval" Property="BorderThickness" Value="4" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Frozen}" Value="True">
                <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource Info}" />
                <Setter TargetName="Oval" Property="BorderThickness" Value="2" />
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource Surface3}" />
                <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xF0717;" />
                <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{StaticResource Info}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Acting}" Value="True">
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                <Setter TargetName="Oval" Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Defending}" Value="True">
                <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource Negative}" />
                <Setter TargetName="Oval" Property="BorderThickness" Value="3" />
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource NegativeSoft}" />
                <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xF04FE;" />
                <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{StaticResource Negative}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Attacking}" Value="True">
                <Setter TargetName="Oval" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Oval" Property="BorderThickness" Value="3" />
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentContainer}" />
                <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xF04E5;" />
                <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Dying}" Value="True">
                <Setter TargetName="Skull" Property="Visibility" Value="Visible" />
                <Setter TargetName="Cell" Property="Opacity" Value="0.4" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A card in our Battlegrounds hand: the full card render; the full card shows on hover -->
    <DataTemplate x:Key="BgHandCard" DataType="{x:Type mt:MatchBgCardItem}">
        <Grid Width="66" Height="100" Margin="1,0" ToolTip="{Binding Tooltip}" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
            <ContentControl Template="{StaticResource CardPlaceholder}" Margin="4,8,4,4" />
            <Image i:CardArt.Card="{Binding CardId}" Stretch="Uniform" />
        </Grid>
    </DataTemplate>

    <!-- A Battlegrounds hero power or trinket: a small round card -->
    <DataTemplate x:Key="BgChip" DataType="{x:Type mt:MatchBgCardItem}">
        <Grid Width="40" Height="40" Margin="4,0,0,0" ToolTip="{Binding Tooltip}" Background="Transparent" c:CardPreview.CardId="{Binding CardId}">
            <Border CornerRadius="20" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1.5" i:CardArt.Portrait="{Binding CardId}" />
        </Grid>
    </DataTemplate>

    <!-- A Battlegrounds hero line (as the Constructed one): trinkets, the portrait with health and its hero powers,
         the hero's name, tavern tier and, in the tavern, our gold. Tag="Opponent" on the host rims the portrait in
         the opponent's accent. -->
    <DataTemplate x:Key="BgHeroLine" DataType="{x:Type mt:MatchBgTableHero}">
        <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Trinkets}" ItemTemplate="{StaticResource BgChip}" ItemsPanel="{StaticResource RowPanel}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Margin="0,0,14,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="62" Height="62" ToolTip="{Binding Name}">
                    <Border x:Name="Portrait" CornerRadius="31" Background="{StaticResource Surface4}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2"
                            i:CardArt.Portrait="{Binding HeroCardId}" />
                    <!-- Health by a heart and armor by a shield, apart: "30 + 15" read as a sum -->
                    <Border CornerRadius="9" Background="{StaticResource Surface3}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1" Padding="5,1,6,1"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-40,0,-40,-8" ToolTip="{Binding HealthTip}"
                            AutomationProperties.Name="{Binding HealthTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF02D1;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Negative}" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock Text="{Binding HealthText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xF0498;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,2,0"
                                       Visibility="{Binding ArmorText, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding ArmorText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center"
                                       Visibility="{Binding ArmorText, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding HeroPowers}" ItemTemplate="{StaticResource BgChip}" ItemsPanel="{StaticResource RowPanel}" Margin="10,0,0,0"
                              VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Match.Player.Table.Tavern}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeLabel}" FontWeight="Bold" Foreground="{StaticResource OnSecondaryContainer}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource AccentContainer}" Margin="8,0,0,0"
                            Visibility="{Binding DataContext.BgTable.Gold, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i:Loc Match.Player.Table.Gold}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding DataContext.BgTable.Gold, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="{StaticResource FontSizeLabel}" FontWeight="Bold" Foreground="{StaticResource OnAccentContainer}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Opponent">
                <Setter TargetName="Portrait" Property="BorderBrush" Value="{StaticResource Accent2Line}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A leaderboard row: place, hero portrait and name (never a player's), tier, health. Ours in the accent; the
         combat opponent on a soft plate; heroes out of the game faded. -->
    <DataTemplate x:Key="LeaderRow" DataType="{x:Type mt:MatchLeaderLine}">
        <Border x:Name="Row" Height="34" CornerRadius="6" Padding="6,0" Margin="0,0,0,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                ToolTip="{Binding Tooltip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Place" Text="{Binding Place}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="26" Height="26" Margin="6,0,8,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}" />
                <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- The tier plate stays empty space before the first tavern (no tier 0) -->
                <Grid Grid.Column="3" Width="20" Height="20" Margin="8,0">
                    <Border CornerRadius="4" Background="{StaticResource Surface3}" Visibility="{Binding Tier, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <!-- Health, then armor by a shield; the tooltip says both in words -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding HealthTip}"
                            AutomationProperties.Name="{Binding HealthTip}">
                    <TextBlock Text="{Binding Health}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                    <TextBlock Text="&#xF0498;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,2,0"
                               Visibility="{Binding Armor, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Armor}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Visibility="{Binding Armor, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Local}" Value="True">
                <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Accent}" />
                <Setter TargetName="Place" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Fighting}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentLine}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Dead}" Value="True">
                <Setter TargetName="Row" Property="Opacity" Value="0.35" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The header's icon buttons on one framed bar over the hero art; hidden when no action applies -->
    <Style x:Key="HeaderActions" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ShowHeaderActions}" Value="False" />
                    <Condition Binding="{Binding CanShareDeck}" Value="False" />
                    <Condition Binding="{Binding CanExportStep}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
