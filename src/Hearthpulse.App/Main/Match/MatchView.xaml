<UserControl x:Class="Hearthpulse.App.Main.Match.MatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hearthpulse.App.Controls"
             xmlns:i="clr-namespace:Hearthpulse.App.Infrastructure"
             xmlns:r="clr-namespace:Hearthpulse.Core.Replay;assembly=Hearthpulse.Core"
             xmlns:mt="clr-namespace:Hearthpulse.App.Main.Match"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <!-- The match page: one History game. DataContext is MainViewModel.MatchPage. Colours are theme tokens only.
         It takes the keyboard focus so the player's keys (code-behind) work on the Replay tab. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Hearthpulse;component/Main/Match/MatchResources.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <Button Style="{StaticResource GhostButton}" Command="{Binding Back}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="12,7" ToolTip="{i:Loc Match.View.BackTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF004D;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,6,0" />
                <TextBlock Text="{i:Loc Match.View.Back}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- While the game's replay is read -->
        <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF051F;" Content="{i:Loc Match.View.Loading}" Margin="0,48,0,0" i:Motion.RevealOnShow="True"
                        Visibility="{Binding Loading, Converter={StaticResource Vis}}" />

        <!-- Header: you, the result, the opponent; then the game's facts -->
        <StackPanel i:Motion.RevealOnShow="True" Visibility="{Binding Loading, Converter={StaticResource Vis}, ConverterParameter=!}">
            <DockPanel>
                <!-- The header's actions on one framed bar, so they read as buttons over the hero art: the step as a picture, the
                     deck as a picture, then the library card's star, Share and View in browser. Gone when none applies. -->
                <Border DockPanel.Dock="Right" Style="{StaticResource HeaderActions}">
                    <StackPanel Orientation="Horizontal">
                        <!-- The step on screen as a PNG picture (plan R4): either mode's table card, as the page shows it -->
                        <Button Style="{StaticResource IconButton}" Content="&#xF0100;" Click="OnExportStep"
                                ToolTip="{i:Loc Match.Export.Tip}" AutomationProperties.Name="{i:Loc Match.Export.Tip}"
                                Visibility="{Binding CanExportStep, Converter={StaticResource Vis}}" />
                        <!-- The player's deck of the game as a picture (proposal C1): a list or a 16:9 cover -->
                        <Button x:Name="DeckImageButton" Style="{StaticResource IconButton}" Content="&#xF0638;"
                                Click="OnDeckImage" ToolTip="{i:Loc Growth.Deck.ButtonTip}" AutomationProperties.Name="{i:Loc Growth.Deck.Button}"
                                Visibility="{Binding CanShareDeck, Converter={StaticResource Vis}}" />
                        <!-- The same star and Share as the game's library card; only with a replay file -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ShowHeaderActions, Converter={StaticResource Vis}}">
                            <Button Command="{Binding ToggleHeaderStar}" ToolTip="{Binding HeaderCard.StarTip}" AutomationProperties.Name="{Binding HeaderCard.StarTip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Content" Value="&#xF04D2;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeaderCard.Starred}" Value="True">
                                                <Setter Property="Content" Value="&#xF04CE;" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xF0497;" Command="{Binding ShareHeader}" ToolTip="{i:Loc Library.Share}"
                                    AutomationProperties.Name="{i:Loc Library.Share}" />
                            <!-- View in browser: the game's page on hearthpulse.net, uploaded first after the question below (docs/web-replays.md) -->
                            <Button Style="{StaticResource IconButton}" Content="{Binding HeaderBrowserGlyph}" Command="{Binding ViewHeaderInBrowser}"
                                    ToolTip="{Binding HeaderBrowserTip}" AutomationProperties.Name="{Binding HeaderBrowserTip}"
                                    Visibility="{Binding ShowHeaderBrowser, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Header.Title}" Style="{StaticResource PageTitle}" FontSize="30" TextWrapping="Wrap" />
                    <c:Wave Style="{StaticResource PageRule}" Margin="2,0,0,10" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Header.Subtitle}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLead}" Margin="2,0,0,18" />
            <!-- The header's status (star, Share, bookmark) or the "only copy" question: one slot, nothing when empty -->
            <DockPanel Margin="2,0,0,12" Visibility="{Binding HeaderStatus, Converter={StaticResource Vis}}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderStatusGlyph}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" VerticalAlignment="Center"
                           Foreground="{Binding HeaderStatusKey, Converter={StaticResource KeyBrush}}" />
                <TextBlock Text="{Binding HeaderStatus}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <Border Margin="0,0,0,12" CornerRadius="8" Padding="12,8" Background="{StaticResource NegativeSoft}" BorderBrush="{StaticResource Negative}" BorderThickness="1"
                    Visibility="{Binding HeaderConfirming, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Margin="8,0,0,0" Content="{i:Loc Library.ConfirmNo}"
                            Command="{Binding CancelHeader}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Foreground="{StaticResource Negative}"
                            Content="{Binding HeaderCard.ConfirmLabel}" Command="{Binding ConfirmHeader}" />
                    <TextBlock Text="&#xF05D6;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource Negative}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderCard.ConfirmText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center">
                            <Border DockPanel.Dock="Left" Width="64" Height="64" Style="{StaticResource StatsPortrait}" BorderBrush="{StaticResource GoldTrim}" BorderThickness="2"
                                    i:CardArt.Portrait="{Binding Header.Local.HeroCardId}" ToolTip="{Binding Header.Local.Hero}" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header.Local.Name}" FontWeight="Bold" FontSize="{StaticResource FontSizeIcon}" TextTrimming="CharacterEllipsis" />
                                <!-- Class and hero on one line while they fit, the hero under the class when not (never cut at 1040) -->
                                <WrapPanel Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource AccentContainer}" Margin="0,0,8,2" VerticalAlignment="Center"
                                            Visibility="{Binding Header.Local.Class, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Header.Local.Class}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                                    </Border>
                                    <TextBlock Text="{Binding Header.Local.Hero}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding Header.Local.Rank, Converter={StaticResource Vis}}">
                                    <TextBlock Text="&#xF04CE;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Header.Local.Rank}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <!-- The result: a plate in the result's colour (win / top half green, loss red, anything else neutral) -->
                        <Border Grid.Column="1" MinWidth="150" CornerRadius="12" BorderThickness="1.5" Padding="22,8,22,10" Margin="18,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface3}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Header.Won}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PositiveSoft}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Positive}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Header.Lost}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NegativeSoft}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource FontSizeSubhead}" Foreground="{Binding Header.ResultKey, Converter={StaticResource KeyBrush}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xF023B;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Header.Won}" Value="True">
                                                    <Setter Property="Text" Value="&#xF0538;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Header.Lost}" Value="True">
                                                    <Setter Property="Text" Value="&#xF068C;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Header.Result}" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="{StaticResource FontSizeHeadline}" HorizontalAlignment="Center"
                                           Foreground="{Binding Header.ResultKey, Converter={StaticResource KeyBrush}}" />
                            </StackPanel>
                        </Border>
                        <DockPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding ShowOpponent, Converter={StaticResource Vis}}">
                            <Border DockPanel.Dock="Right" Width="64" Height="64" Style="{StaticResource StatsPortrait}" BorderBrush="{StaticResource Accent2Line}" BorderThickness="2"
                                    i:CardArt.Portrait="{Binding Header.Opponent.HeroCardId}" ToolTip="{Binding Header.Opponent.Hero}" />
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header.Opponent.Name}" FontWeight="Bold" FontSize="{StaticResource FontSizeIcon}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <!-- Hero and class on one line while they fit, the class under the hero when not (never cut at 1040) -->
                                <WrapPanel Margin="0,4,0,0" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Header.Opponent.Hero}" Style="{StaticResource Caption}" Margin="0,0,8,2" VerticalAlignment="Center" TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}" VerticalAlignment="Center"
                                            Visibility="{Binding Header.Opponent.Class, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Header.Opponent.Class}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                                    </Border>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0" Visibility="{Binding Header.Opponent.Rank, Converter={StaticResource Vis}}">
                                    <TextBlock Text="&#xF04CE;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Header.Opponent.Rank}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <!-- Facts (duration, turns, coin, decks...): one strip, values in the display face; a long value takes the width it
                         needs and the strip wraps, where equal columns cut "Вы ходили с монеткой" at 1040 -->
                    <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="16,10,0,2" Margin="0,18,0,0">
                        <ItemsControl ItemsSource="{Binding Header.Facts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type r:MatchFact}">
                                    <StackPanel MinWidth="160" MaxWidth="360" Margin="0,0,16,8">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTitle}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Missing, Converter={StaticResource Vis}}">
                <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF02FC;" Content="{Binding Missing}" />
            </Border>

            <!-- Tabs -->
            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="{Binding IsConstructed, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabReplay" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabReplay}" GroupName="MatchTab" IsChecked="{Binding ShowReplay}" />
                    <RadioButton x:Name="TabDecks" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabDecks}" GroupName="MatchTab" IsChecked="{Binding ShowDecks}" />
                    <RadioButton x:Name="TabAnalysis" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabAnalysis}" GroupName="MatchTab" IsChecked="{Binding ShowAnalysis}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="{Binding IsBattlegrounds, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabBgReplay" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabReplay}" GroupName="MatchBgTab" IsChecked="{Binding ShowReplay}"
                                 Visibility="{Binding HasBattlegroundsSteps, Converter={StaticResource Vis}}" />
                    <RadioButton Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabRounds}" GroupName="MatchBgTab" IsChecked="{Binding ShowRounds}" />
                    <RadioButton x:Name="TabLobby" Style="{StaticResource Tab}" Content="{i:Loc Match.View.TabLobby}" GroupName="MatchBgTab" IsChecked="{Binding ShowLobby}" />
                </StackPanel>
            </Border>
            <!-- A Battlegrounds file of format 3: rounds and lobby only -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,12" Visibility="{Binding ShowBattlegroundsOldNote, Converter={StaticResource Vis}}">
                <TextBlock Text="&#xF02FD;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{i:Loc Match.Player.BgOldFile}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===== Replay: the player (timeline over the bar), then the table of the mode ===== -->
            <StackPanel i:Motion.RevealOnShow="True" Visibility="{Binding ShowReplay, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- "Turn" (G) on the left; the bookmark, ‹ "Bookmarks" › on the right -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TurnBox" Width="168" MinHeight="32" Padding="10,5,32,5" VerticalAlignment="Center" ItemsSource="{Binding Jumps}"
                                      SelectedIndex="{Binding JumpIndex, Mode=TwoWay}" IsDropDownOpen="{Binding TurnsOpen, Mode=TwoWay}" ItemTemplate="{StaticResource JumpItem}"
                                      ToolTip="{i:Loc Match.Player.TurnTip}" AutomationProperties.Name="{i:Loc Match.Player.Turn}" DropDownClosed="OnTurnsClosed" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding CanBookmark, Converter={StaticResource Vis}}">
                                <Button Focusable="False" Content="{Binding BookmarkGlyph}" Command="{Binding ToggleBookmark}" ToolTip="{Binding BookmarkTip}"
                                        AutomationProperties.Name="{Binding BookmarkTip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Focusable="False" Width="28" Height="28" FontSize="{StaticResource FontSizeTitle}" Margin="8,0,0,0" Content="&#xF0141;"
                                        Command="{Binding PreviousBookmark}" IsEnabled="{Binding HasPreviousBookmark}" ToolTip="{i:Loc Match.Player.PreviousBookmark}"
                                        AutomationProperties.Name="{i:Loc Match.Player.PreviousBookmark}" ToolTipService.ShowOnDisabled="True" />
                                <Button x:Name="BookmarksButton" Style="{StaticResource GhostButton}" Focusable="False" Padding="10,4" Margin="4,0" VerticalAlignment="Center" Click="OnBookmarksMenu"
                                        ContextMenuOpening="OnBookmarksMenuOpening" ToolTip="{Binding BookmarksTip}" AutomationProperties.Name="{Binding BookmarksTip}">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource BookmarkMenu}" />
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0E15;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource OnSecondaryContainer}" VerticalAlignment="Center" />
                                        <TextBlock Text="{i:Loc Match.Player.Bookmarks}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BookmarkCountText}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Visibility="{Binding BookmarkCountText, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="&#xF0140;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource OnSecondaryContainer}" Margin="4,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Focusable="False" Width="28" Height="28" FontSize="{StaticResource FontSizeTitle}" Content="&#xF0142;"
                                        Command="{Binding NextBookmark}" IsEnabled="{Binding HasNextBookmark}" ToolTip="{i:Loc Match.Player.NextBookmark}"
                                        AutomationProperties.Name="{i:Loc Match.Player.NextBookmark}" ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                        </Grid>
                        <mt:MatchTimeline Segments="{Binding TimelineSegments}" Ticks="{Binding TimelineTicks}" Current="{Binding TimelineCurrent}"
                                          Position="{Binding TimelinePosition}" FrameMax="{Binding FrameMax}" Bookmarks="{Binding BookmarkMarks}" Command="{Binding GoFrame}" />
                        <!-- Turn ‹ event ‹ step ‹ play › step › event › turn; speed, position; side (Constructed) and the keys -->
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Focusable="False" Content="&#xF04AE;" Command="{Binding PreviousTurn}" ToolTip="{i:Loc Match.Player.PreviousTurn}" AutomationProperties.Name="{i:Loc Match.Player.PreviousTurn}" />
                                <Button Style="{StaticResource IconButton}" Focusable="False" Content="&#xF0141;" Command="{Binding PreviousEvent}" ToolTip="{i:Loc Match.Player.PreviousEvent}" AutomationProperties.Name="{i:Loc Match.Player.PreviousEvent}" Margin="4,0,0,0" />
                                <Button Style="{StaticResource IconButton}" Focusable="False" Content="&#xF04D5;" Command="{Binding Previous}" ToolTip="{i:Loc Match.Player.PreviousStep}" AutomationProperties.Name="{i:Loc Match.Player.PreviousStep}" Margin="4,0,0,0" />
                                <Button Style="{StaticResource PrimaryButton}" Focusable="False" Width="44" Height="32" Padding="0" Margin="12,0" Command="{Binding TogglePlay}" ToolTip="{Binding PlayTip}" AutomationProperties.Name="{Binding PlayTip}">
                                    <TextBlock Text="{Binding PlayGlyph}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource OnAccent}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Focusable="False" Content="&#xF04D7;" Command="{Binding Next}" ToolTip="{i:Loc Match.Player.NextStep}" AutomationProperties.Name="{i:Loc Match.Player.NextStep}" />
                                <Button Style="{StaticResource IconButton}" Focusable="False" Content="&#xF0142;" Command="{Binding NextEvent}" ToolTip="{i:Loc Match.Player.NextEvent}" AutomationProperties.Name="{i:Loc Match.Player.NextEvent}" Margin="4,0,0,0" />
                                <Button Style="{StaticResource IconButton}" Focusable="False" Content="&#xF04AD;" Command="{Binding NextTurn}" ToolTip="{i:Loc Match.Player.NextTurn}" AutomationProperties.Name="{i:Loc Match.Player.NextTurn}" Margin="4,0,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Focusable="False" Padding="10,4" MinWidth="44" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding CycleSpeed}" ToolTip="{i:Loc Match.Player.SpeedTip}">
                                <TextBlock Text="{Binding SpeedText}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeLabel}" FontWeight="Bold" />
                            </Button>
                            <TextBlock Text="{Binding Position}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0" />
                            <Border Style="{StaticResource SegmentBar}" ToolTip="{i:Loc Match.View.SideTip}" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding ShowSide, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="{i:Loc Match.View.MySide}" GroupName="MatchSide" IsChecked="{Binding BottomLocal}" />
                                    <RadioButton x:Name="SideOpponent" Style="{StaticResource Segment}" Content="{i:Loc Match.View.TheirSide}" GroupName="MatchSide" IsChecked="{Binding BottomOpponent}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource IconButton}" Focusable="False" Content="&#xF0625;" VerticalAlignment="Center" ToolTip="{Binding HelpText}" AutomationProperties.Name="{i:Loc Match.Player.HelpName}"
                                    ToolTipService.ShowDuration="30000" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Constructed: both sides, the step, the game's event feed (plan R2: the feed's column 260-320, its height
                     the table's, set by the code-behind so the list never stretches the row) -->
                <StackPanel Visibility="{Binding ShowConstructedTable, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.5*" MinWidth="260" MaxWidth="320" />
                        </Grid.ColumnDefinitions>
                        <!-- The table, the step's arrow over it (it never takes the mouse) -->
                        <Border x:Name="TableCard" Style="{StaticResource Card}" Padding="18,14" VerticalAlignment="Top" DataContext="{Binding Table}" SizeChanged="OnTableSized">
                            <Grid>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Top.Hand}" ItemTemplate="{StaticResource HandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="116" />
                                    <ContentControl Content="{Binding Top}" ContentTemplate="{StaticResource HeroLine}" />
                                    <ItemsControl ItemsSource="{Binding Top.Board}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource CardRow}" MinHeight="146" Margin="0,4" />
                                    <!-- The step: whose it is shows in the edge and turn colour (gold yours, second accent theirs) -->
                                    <Border CornerRadius="8" Padding="12,7" Margin="0,8" BorderThickness="3,0,0,0" mt:MatchArrowLayer.Middle="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Accent2Soft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent2Line}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LocalActs}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Turn}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent2}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LocalActs}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}" />
                                        </DockPanel>
                                    </Border>
                                    <!-- The step's choice: the Discover options, or both mulligans -->
                                    <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceRow}" Margin="0,0,0,6"
                                                  Visibility="{Binding Choices.Count, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Bottom.Board}" ItemTemplate="{StaticResource Minion}" ItemsPanel="{StaticResource CardRow}" MinHeight="146" Margin="0,4" />
                                    <ContentControl Content="{Binding Bottom}" ContentTemplate="{StaticResource HeroLine}" />
                                    <ItemsControl ItemsSource="{Binding Bottom.Hand}" ItemTemplate="{StaticResource HandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="116" />
                                </StackPanel>
                                <mt:MatchArrowLayer x:Name="Arrow" From="{Binding ActorRef}" To="{Binding TargetRef}" IsAttack="{Binding IsAttack}" Local="{Binding LocalActs}"
                                                    Version="{Binding Version}" />
                            </Grid>
                        </Border>
                        <!-- The game's event feed: every action under its turn's header, the step on screen kept in view. Only
                             the rows near the view are built (a whole game is 100-300 rows of about 20 visuals), so the card's
                             height is never unbounded: 420 until the table is measured, then the table's. -->
                        <Border x:Name="FeedCard" Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" MinHeight="420" Height="420" VerticalAlignment="Top">
                            <DockPanel>
                                <c:Ornament DockPanel.Dock="Top" Text="{i:Loc Match.View.Feed}" Icon="&#xF0279;" Size="13" Margin="0,0,0,8" />
                                <ItemsControl x:Name="Feed" ItemsSource="{Binding FeedRows}" ItemTemplate="{StaticResource FeedRow}" Focusable="False"
                                              AutomationProperties.Name="{i:Loc Match.View.FeedName}"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5" VirtualizingPanel.CacheLengthUnit="Page">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer x:Name="FeedScroll" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          Focusable="False">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TableNote}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" Margin="2,10,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Battlegrounds (format 4): the step's table, ours at the bottom; the leaderboard and the stretch's events -->
                <Grid x:Name="BattlegroundsTable" Visibility="{Binding ShowBattlegroundsTable, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BattlegroundsStepCard" Style="{StaticResource Card}" Padding="18,14" VerticalAlignment="Top" DataContext="{Binding BgTable}">
                        <StackPanel>
                            <!-- Top: Bob's offer in the tavern, the combat opponent in combat, the hero choice before the first
                                 tavern (no Bob yet); one height, so the step bar stays put -->
                            <Grid MinHeight="168">
                                <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceRow}" VerticalAlignment="Center"
                                              Visibility="{Binding ChoicesOnTop, Converter={StaticResource Vis}}" />
                                <StackPanel Visibility="{Binding ShowShop, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal" Height="28">
                                        <TextBlock Text="{i:Loc Match.Player.Table.BobOffer}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Info}" BorderThickness="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center" Visibility="{Binding ShopFrozen, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xF0717;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeLabel}" Foreground="{StaticResource Info}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{i:Loc Match.Keyword.FROZEN}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Info}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Grid MinHeight="96">
                                        <ItemsControl ItemsSource="{Binding Shop}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                        <TextBlock Text="{i:Loc Match.Player.Table.EmptyShop}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Visibility="{Binding Shop.Count, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding InCombat, Converter={StaticResource Vis}}">
                                    <ContentControl Content="{Binding Opponent}" ContentTemplate="{StaticResource BgHeroLine}" Tag="Opponent"
                                                    Visibility="{Binding Opponent, Converter={StaticResource Vis}}" />
                                    <Grid MinHeight="96">
                                        <ItemsControl ItemsSource="{Binding OpponentBoard}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                        <TextBlock Text="{i:Loc Match.Player.Table.EmptyBoard}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Visibility="{Binding OpponentBoard.Count, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <!-- The step: tavern in the accent, combat neutral, the end of a combat in its result's colour -->
                            <Border CornerRadius="8" Padding="12,7" Margin="0,8" BorderThickness="3,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InCombat}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Surface3}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource GoldTrim}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ResultKey}" Value="Tie">
                                                <Setter Property="Background" Value="{StaticResource Surface3}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ResultKey}" Value="Win">
                                                <Setter Property="Background" Value="{StaticResource PositiveSoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Positive}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ResultKey}" Value="Loss">
                                                <Setter Property="Background" Value="{StaticResource NegativeSoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InCombat}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource Surface3}" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding ResultKey, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Action}" FontSize="{StaticResource FontSizeLabel}" FontWeight="Bold" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" MaxWidth="260" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Action}" />
                                </DockPanel>
                            </Border>
                            <!-- The step's choice in the game: Discover, trinket, quest (the hero choice is on top) -->
                            <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceRow}" Margin="0,0,0,6"
                                          Visibility="{Binding ChoicesBelow, Converter={StaticResource Vis}}" />
                            <!-- Bottom: our board, hero and hand; in a Duos combat our partner's board and hero while their table fights -->
                            <StackPanel Visibility="{Binding PartnerFighting, Converter={StaticResource Vis}, ConverterParameter=!}">
                                <Grid MinHeight="96">
                                    <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                    <TextBlock Text="{i:Loc Match.Player.Table.EmptyBoard}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="{Binding ShowEmptyBoard, Converter={StaticResource Vis}}" />
                                </Grid>
                                <ContentControl Content="{Binding Hero}" ContentTemplate="{StaticResource BgHeroLine}" Visibility="{Binding Hero, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <StackPanel x:Name="BattlegroundsPartner" Visibility="{Binding PartnerFighting, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal" Height="28">
                                    <TextBlock Text="{i:Loc Match.Player.Table.Partner}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid MinHeight="96">
                                    <ItemsControl ItemsSource="{Binding PartnerBoard}" ItemTemplate="{StaticResource BgBoardMinion}" ItemsPanel="{StaticResource CardRow}" />
                                    <TextBlock Text="{i:Loc Match.Player.Table.EmptyBoard}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="{Binding PartnerBoard.Count, Converter={StaticResource Vis}, ConverterParameter=!}" />
                                </Grid>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Hand}" ItemTemplate="{StaticResource BgHandCard}" ItemsPanel="{StaticResource CardRow}" MinHeight="100" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <c:Ornament Text="{i:Loc Match.Player.Leaderboard}" Icon="&#xF0D25;" Size="13" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Leaders}" ItemTemplate="{StaticResource LeaderRow}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,16,0,0">
                            <DockPanel>
                                <c:Ornament DockPanel.Dock="Top" Text="{Binding ActionsTitle}" Icon="{Binding ActionsIcon}" Size="13" Margin="0,0,0,8" />
                                <ScrollViewer x:Name="BgActionsScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="BgActions" ItemsSource="{Binding ActionRows}" ItemTemplate="{StaticResource ActionRow}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="2,8,0,0" Visibility="{Binding Truncated, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xF05D6;" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource Negative}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{i:Loc Match.Player.Truncated}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Decks ===== -->
            <Grid i:Motion.RevealOnShow="True" Visibility="{Binding ShowDecks, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Match.View.YourDeck}" Icon="&#xF0638;" Size="13" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding LocalDeckNote}" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding LocalDeck}" ItemTemplate="{StaticResource DeckRow}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.OpponentCards}" Icon="&#xF06D0;" Size="13" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OpponentCardsNote}" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,0,0,10" Background="{StaticResource AccentContainer}"
                                    Visibility="{Binding ArchetypeLine, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding ArchetypeLine}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource OnAccentContainer}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding OpponentCards}" ItemTemplate="{StaticResource DeckRow}" />
                            <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF06D0;" Content="{Binding OpponentCardsEmpty}"
                                            Visibility="{Binding OpponentCards, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        </StackPanel>
                    </Border>
                    <!-- The archetype's most played meta list: a guess, and says so -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding OpponentPredicted, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource SecondaryContainer}" VerticalAlignment="Center">
                                    <TextBlock Text="{i:Loc Match.View.PredictedBadge}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" Foreground="{StaticResource OnSecondaryContainer}" />
                                </Border>
                                <c:Ornament Text="{i:Loc Match.View.Predicted}" Icon="&#xF0638;" Size="13" HorizontalAlignment="Left" />
                            </DockPanel>
                            <TextBlock Text="{Binding OpponentPredictedNote}" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding OpponentPredicted}" ItemTemplate="{StaticResource DeckRow}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

            <!-- ===== Analysis (Core MatchAnalysis) ===== -->
            <StackPanel i:Motion.RevealOnShow="True" Visibility="{Binding ShowAnalysis, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Analysis.Tiles}" ItemsPanel="{StaticResource StatsTilesPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type r:AnalysisTile}">
                                <StackPanel Margin="0,0,18,0" ToolTip="{Binding Detail}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Stat}" FontSize="25" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.HealthChart}" Icon="&#xF02D1;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip="{i:Loc Match.View.HealthChartNote}" />
                            <c:Sparkline Height="140" Values="{Binding Analysis.LocalHealth}" Compare="{Binding Analysis.OpponentHealth}" Maximum="{Binding Analysis.HealthMaximum}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.BoardChart}" Icon="&#xF0787;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip="{i:Loc Match.View.BoardChartNote}" />
                            <c:Sparkline Height="140" Values="{Binding Analysis.LocalBoard}" Compare="{Binding Analysis.OpponentBoard}" Maximum="{Binding Analysis.BoardMaximum}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.KeyCards}" Icon="&#xF01A5;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip="{i:Loc Match.View.KeyCardsNote}" />
                            <ItemsControl ItemsSource="{Binding Analysis.KeyCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:KeyCardRow}">
                                        <Border Style="{StaticResource StatsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock x:Name="Who" Grid.Column="2" Text="{i:Loc Match.Opponent}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Local}" Value="True">
                                                <Setter TargetName="Who" Property="Text" Value="{i:Loc Match.You}" />
                                                <Setter TargetName="Who" Property="Foreground" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Style="{StaticResource EmptyState}" Tag="&#xF01A5;" Content="{i:Loc Match.View.NoKeyCards}"
                                            Visibility="{Binding Analysis.KeyCards, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.Mulligan}" Icon="&#xF0450;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Analysis.MulliganNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{i:Loc Match.You}" Style="{StaticResource StatsHead}" />
                                <TextBlock Grid.Column="2" Text="{i:Loc Match.View.MetaKeep}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Match.View.MetaKeepTip}" />
                                <TextBlock Grid.Column="3" Text="{i:Loc Match.View.HeldWinRate}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" ToolTip="{i:Loc Match.View.HeldWinRateTip}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Analysis.Mulligan}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:MulliganCardRow}">
                                        <Border Style="{StaticResource StatsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" Margin="0,0,10,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding CardId}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Mark" Text="" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeBody}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Choice" Text="{Binding Choice}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding MetaKeep}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding MetaWinRate}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kept}" Value="False">
                                                <Setter TargetName="Choice" Property="Foreground" Value="{StaticResource Muted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Agreement}" Value="1">
                                                <Setter TargetName="Mark" Property="Text" Value="&#xF012C;" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Positive}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Agreement}" Value="-1">
                                                <Setter TargetName="Mark" Property="Text" Value="&#xF0026;" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Negative}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding Analysis.MulliganReceived, Converter={StaticResource Vis}}">
                                <Run Text="{i:Loc Match.View.CameInstead}" /><Run Text="{Binding Analysis.MulliganReceivedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.ManaChart}" Icon="&#xF05E0;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip="{i:Loc Match.View.ManaChartNote}" />
                            <c:MiniBars Height="80" Values="{Binding Analysis.LocalMana}" Compare="{Binding Analysis.ManaFull}" ShowLabels="True" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <c:Ornament Text="{i:Loc Match.View.AgainstMeta}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Analysis.Meta}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:MatchFact}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Analysis.MetaNote}" Style="{StaticResource Caption}" FontSize="{StaticResource FontSizeLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:Ornament Text="{i:Loc Match.View.TurnByTurn}" Icon="&#xF0467;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <Grid Margin="10,0,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i:Loc Match.View.ColTurn}" Style="{StaticResource StatsHead}" />
                            <TextBlock Grid.Column="1" Text="{i:Loc Match.View.ColYourHp}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="2" Text="{i:Loc Match.View.ColTheirHp}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="3" Text="{i:Loc Match.View.YourBoard}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="4" Text="{i:Loc Match.View.ColTheirBoard}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="5" Text="{i:Loc Match.View.ColMana}" Style="{StaticResource StatsHead}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="6" Text="{i:Loc Match.View.ColPlayed}" Style="{StaticResource StatsHead}" Margin="6,0,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Analysis.TurnRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type r:AnalysisTurnRow}">
                                    <Border Style="{StaticResource StatsRow}" Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{StaticResource Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding LocalHealth}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding OpponentHealth}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding LocalBoard}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding OpponentBoard}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="5" Text="{Binding Mana}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="6" Text="{Binding Played}" Style="{StaticResource Caption}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Played}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Local}" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Battlegrounds rounds ===== -->
            <ItemsControl ItemsSource="{Binding Rounds}" i:Motion.RevealOnShow="True" Visibility="{Binding ShowRounds, Converter={StaticResource Vis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type r:MatchRoundView}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontWeight="Bold" Foreground="{Binding ResultKey, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{i:Loc Match.View.YourBoard}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Board}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Visibility="{Binding OpponentHeroCardId, Converter={StaticResource Vis}}">
                                        <Border Width="44" Height="44" Style="{StaticResource StatsPortrait}" HorizontalAlignment="Center" BorderBrush="{StaticResource GoldTrim}" BorderThickness="1"
                                                i:CardArt.Portrait="{Binding OpponentHeroCardId}" ToolTip="{Binding OpponentHero}" />
                                        <TextBlock Text="{i:Loc Match.View.Versus}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding OpponentHero}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding OpponentBoard}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding Shop, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{i:Loc Match.View.TavernOffers}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Shop}" ItemTemplate="{StaticResource BgMinion}" ItemsPanel="{StaticResource Wrap}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Battlegrounds lobby ===== -->
            <Border Style="{StaticResource Card}" i:Motion.RevealOnShow="True" Visibility="{Binding ShowLobby, Converter={StaticResource Vis}}">
                <StackPanel>
                    <c:Ornament Text="{i:Loc Match.View.TabLobby}" Icon="&#xF0849;" Size="13" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Lobby}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type r:MatchLobbyRow}">
                                <Border Style="{StaticResource StatsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Place" Text="{Binding Place}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0" Style="{StaticResource StatsPortrait}" i:CardArt.Portrait="{Binding HeroCardId}" />
                                        <TextBlock Grid.Column="2" x:Name="Name" Text="{Binding Hero}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Local}" Value="True">
                                        <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Place" Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
