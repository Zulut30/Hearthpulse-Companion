<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Hearthpulse.UI.Overlay"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             x:Class="Hearthpulse.UI.Overlay.ArenaPicksPanel"
             x:DataType="o:OverlayViewModel">
    <!-- Arena draft: a badge over each offered card (ArenaSmith score and tier, the package it brings, our deck-fit
         adjustment) or hero (class win rate, 7+ wins and place), the best one marked by its star and gold frame. Laid across
         the width of the draft screen's card row, so each badge sits over its card; a hero without numbers keeps its slot
         and draws nothing. Nothing here takes clicks: the cards under it stay clickable. DataContext: OverlayViewModel.
         Tokens only (hearthpulse-design). -->
    <UserControl.Resources>
        <i:KeyBrush x:Key="KeyBrush" />
        <i:Truthy x:Key="Truthy" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.arenaBadge">
            <Setter Property="Background" Value="{DynamicResource OverlayPanelSolid}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="6,5,14,5" />
            <Setter Property="MinWidth" Value="146" />
        </Style>
        <Style Selector="Border.arenaBadge.best">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
        <Style Selector="TextBlock.badgeCaption">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style Selector="TextBlock.badgeCaption.best">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Width="{Binding ArenaPickRowWidth}" IsHitTestVisible="False">
        <Border Height="{Binding ArenaPickDrop}" />
        <ItemsControl ItemsSource="{Binding ArenaPicks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="o:ArenaPickBadge">
                    <Border Classes="arenaBadge" Classes.best="{Binding IsBest}" HorizontalAlignment="Center" IsVisible="{Binding !Empty}">
                        <!-- A dock, not a horizontal stack: the lines beside the seal get the cell's width and wrap in it. At overlay scale 1.6
                             a cell is narrower than the badge's text, which was cut at the next badge (bug-hunt #11) -->
                        <DockPanel HorizontalAlignment="Center">
                            <!-- The tier letter is the badge's first read, as on the site's tier list. Without a tier (no numbers) the seal is a
                                 dark one with a question mark: an empty light seal read as a missing picture -->
                            <Panel DockPanel.Dock="Left" Width="42" Height="42" VerticalAlignment="Center">
                                <c:Scallop Fill="{Binding Tier, Converter={StaticResource KeyBrush}}" Lobes="9" Depth="0.1" IsVisible="{Binding Tier, Converter={StaticResource Truthy}}" />
                                <TextBlock Text="{Binding Tier}" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <c:Scallop Fill="{StaticResource Surface3}" Lobes="9" Depth="0.1" IsVisible="{Binding Tier, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                                <TextBlock Text="?" FontFamily="{DynamicResource DisplayFont}" FontSize="{StaticResource FontSizeSubhead}" FontWeight="Bold" Foreground="{StaticResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Tier, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                            </Panel>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF04CE;" Classes="icon" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0"
                                               IsVisible="{Binding IsBest}" />
                                    <TextBlock Text="{Binding Number}" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="Bold"
                                               Foreground="{Binding Tier, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center"
                                               IsVisible="{Binding Tier, Converter={StaticResource Truthy}}" />
                                    <TextBlock Text="{Binding Number}" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                               IsVisible="{Binding Tier, Converter={StaticResource Truthy}, ConverterParameter=!}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Caption}" Classes="badgeCaption" Classes.best="{Binding IsBest}" TextWrapping="Wrap"
                                           IsVisible="{Binding Caption, Converter={StaticResource Truthy}}" />
                                <!-- Where the card would sit in the deck: its curve bucket, its type (or package) -->
                                <TextBlock Text="{Binding FitCost}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           IsVisible="{Binding FitCost, Converter={StaticResource Truthy}}" />
                                <TextBlock Text="{Binding FitType}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           IsVisible="{Binding FitType, Converter={StaticResource Truthy}}" />
                                <!-- Our own adjustment for the deck so far, on a line of its own: the big number stays the source's score -->
                                <TextBlock Text="{Binding DeckFit}" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           IsVisible="{Binding DeckFit, Converter={StaticResource Truthy}}" />
                                <TextBlock Text="{Binding DeckFitWhy}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="150"
                                           IsVisible="{Binding DeckFitWhy, Converter={StaticResource Truthy}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
