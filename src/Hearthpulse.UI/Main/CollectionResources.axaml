<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="using:Hearthpulse.UI.Main"
                    xmlns:i="using:Hearthpulse.UI.Infrastructure">
    <!-- What the meta view and the deck page share of the collection; each includes it, so it is found when the view is
         built on its own. Theme tokens only; the WPF twin is Main/CollectionResources.xaml. -->
    <i:Truthy x:Key="Truthy" />

    <!-- The player's collection (docs/collection.md): a deck's build label, a glyph and words, dimmed by a saved
         collection; one missing card; and the reason, the missing cards and the sum behind a label. -->
    <DataTemplate x:Key="DeckBuildLabel" x:DataType="m:DeckBuildView">
        <DockPanel Opacity="{Binding Opacity}">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Classes="icon" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLabel}" TextWrapping="Wrap" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="MissingCardTemplate" x:DataType="m:MissingCardRow">
        <Grid Margin="0,3" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Note}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Price}" Classes="caption" Margin="16,0,0,0" VerticalAlignment="Top" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DeckMissingList" x:DataType="m:DeckBuildView">
        <StackPanel>
            <TextBlock Text="{Binding Tip}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding HasTip}" />
            <TextBlock Text="{i:Loc Collection.Missing.Title}" Classes="tableHead" Margin="0,0,0,4" IsVisible="{Binding HasMissing}" />
            <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource MissingCardTemplate}" />
            <TextBlock Text="{Binding Total}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding Total, Converter={StaticResource Truthy}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
