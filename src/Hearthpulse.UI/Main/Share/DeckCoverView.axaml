<UserControl x:Class="Hearthpulse.UI.Main.Share.DeckCoverView"
             x:DataType="s:ShareViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:s="using:Hearthpulse.UI.Main.Share"
             Width="960" Height="540">
    <!-- The deck picture, 16:9 cover (proposal C1), as WPF's Main/Share/DeckCoverView.xaml: 960 × 540 DIP, saved at 1920 × 1080. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Share/ShareLook.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Hearthpulse.UI/Main/Share/ShareStyles.axaml" />
    </UserControl.Styles>

    <Panel Background="{StaticResource Bg}" ClipToBounds="True">
        <Image i:CardArt.Splash="{Binding Deck.HeroCardId}" Width="520" HorizontalAlignment="Left" Stretch="UniformToFill" Opacity="0.6" />
        <Rectangle Width="520" HorizontalAlignment="Left" Fill="{StaticResource Bg}" OpacityMask="{StaticResource ShareArtMask}" />

        <Grid Margin="40,32" ColumnDefinitions="360,*">
            <!-- The class, name, facts and curve as one block on the field's middle line, the list's too (TASK-2026-11-25-polish
                 S5: a text block in the middle, the curve on the bottom and the list on the top left holes between them); the
                 footer keeps the bottom. The equal star rows centre the block on the whole field. -->
            <Grid Margin="0,0,32,0" RowDefinitions="*,Auto,*">
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding Deck.ClassName}" Classes="label" FontSize="{StaticResource FontSizeLead}" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding Deck.Name}" Classes="wordmark" FontSize="{StaticResource FontSizeDisplay}" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding Deck.Facts}" Classes="caption" FontSize="{StaticResource FontSizeLead}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Deck.Curve}" ItemTemplate="{StaticResource ShareCurveBar}" Margin="0,24,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <TextBlock DockPanel.Dock="Right" Text="{i:Loc Growth.Share.Site}" Classes="site" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
                    <Image Source="{StaticResource HearthpulseLogo}" Width="24" Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="Hearthpulse" Classes="wordmark" FontSize="{StaticResource FontSizeLead}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BattleTag}" Classes="label" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" s:ShareTextFit.Mode="Line" />
                </DockPanel>
            </Grid>

            <!-- Two columns of even rows on the field's middle line, both starting and ending on one line (DeckPictureCard.CoverList*):
                 rows grow from 28 to 36 while the field has room; a longer deck (over 15 rows a column) is laid out wider and
                 shrinks as a whole to the field. One name size a column (ShareTextFit.Scope), never under 9 as shown. -->
            <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid Width="{Binding Deck.CoverListWidth}" Height="{Binding Deck.CoverListHeight}" ColumnDefinitions="*,8,*"
                      s:ShareTextFit.MinFontSize="{Binding Deck.CoverNameMinFontSize}">
                    <ItemsControl ItemsSource="{Binding Deck.FirstColumn}" ItemTemplate="{StaticResource ShareDeckRow}" Focusable="False" s:ShareTextFit.Scope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" Rows="{Binding Deck.ColumnRows}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Deck.SecondColumn}" ItemTemplate="{StaticResource ShareDeckRow}" Focusable="False" s:ShareTextFit.Scope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" Rows="{Binding Deck.ColumnRows}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Viewbox>
        </Grid>
    </Panel>
</UserControl>
