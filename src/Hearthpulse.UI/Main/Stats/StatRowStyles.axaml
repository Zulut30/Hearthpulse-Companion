<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:Hearthpulse.UI.Main">
    <!-- A group row (StatGroupRowTemplate, StatsResources.axaml): class / opponent / archetype on Arena, Brawl and
         Constructed. Included by StatsStyles.axaml and by BrawlView, which has no other stats styles.
         Wide: the name and its games line on one line each, cut with the whole text in a tooltip, and the win rate in a
         132 column with its bar. Compact (MainView): the bar steps aside and the name and its line wrap, so a long
         class name ("Рыцарь смерти") and the drafts line are read whole (bug-hunt #7). -->
    <Style Selector="TextBlock.groupText">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="m|MainView.compact TextBlock.groupText">
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.groupWin">
        <Setter Property="Width" Value="132" />
    </Style>
    <Style Selector="m|MainView.compact StackPanel.groupWin">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
</Styles>
