<UserControl x:Class="Hearthpulse.UI.Main.Cards.CardPageView"
             x:DataType="k:CardPageViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Hearthpulse.UI.Controls"
             xmlns:i="using:Hearthpulse.UI.Infrastructure"
             xmlns:k="using:Hearthpulse.UI.Main.Cards"
             xmlns:m="using:Hearthpulse.UI.Main"
             xmlns:sys="using:System">
    <!-- The card page: one Constructed card (docs/card-page.md). DataContext is MainViewModel.CardPage. Colours are theme tokens only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hearthpulse.UI/Main/Stats/StatsResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A number of the card: label, gold rule, value, what it is counted from. The texts wrap: nothing is cut. -->
            <DataTemplate x:Key="CardTile" x:DataType="m:StatTile">
                <Border Classes="card tile" Padding="16,12,16,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Classes="label" TextWrapping="Wrap" />
                        <Border Width="22" Height="2" CornerRadius="1" Background="{StaticResource AccentLine}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Value}" Classes="stat statsValue" Margin="0,4,0,2"
                                   Foreground="{Binding Sign, Converter={StaticResource SignBrush}, ConverterParameter=text}" />
                        <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="CardTilesPanel">
                <UniformGrid Classes="fixed cardTiles" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Three tiles in a row, two in compact -->
        <Style Selector="UniformGrid.cardTiles">
            <Setter Property="Columns" Value="3" />
        </Style>
        <Style Selector="m|MainView.compact UniformGrid.cardTiles">
            <Setter Property="Columns" Value="2" />
        </Style>
        <!-- A column head wraps instead of trimming; a number and its head sit right. The cell's width is its column's. -->
        <Style Selector="TextBlock.cardHead">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="TextBlock.cardNumber">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <!-- The columns' widths: the head and every row share them, so the numbers line up under their heads -->
        <Style Selector=":is(Control).cA1">
            <Setter Property="Width" Value="132" />
        </Style>
        <Style Selector=":is(Control).cA2">
            <Setter Property="Width" Value="56" />
        </Style>
        <Style Selector=":is(Control).cA3">
            <Setter Property="Width" Value="112" />
        </Style>
        <Style Selector=":is(Control).cA4">
            <Setter Property="Width" Value="68" />
        </Style>
        <Style Selector=":is(Control).cM1">
            <Setter Property="Width" Value="88" />
        </Style>
        <Style Selector=":is(Control).cM2">
            <Setter Property="Width" Value="102" />
        </Style>
        <Style Selector=":is(Control).cM4">
            <Setter Property="Width" Value="96" />
        </Style>
        <!-- Compact: the archetype's name takes the row's whole width and the numbers go under it, so a long name is not
             squeezed into what the number columns leave -->
        <Style Selector="m|MainView.compact :is(Control).cardName">
            <Setter Property="Grid.ColumnSpan" Value="5" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).cardHead">
            <Setter Property="Grid.Row" Value="1" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).cardNumber">
            <Setter Property="Grid.Row" Value="1" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).cardNum">
            <Setter Property="Grid.Row" Value="1" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).cA1">
            <Setter Property="Width" Value="104" />
        </Style>
        <Style Selector="m|MainView.compact :is(Control).cA3">
            <Setter Property="Width" Value="88" />
        </Style>
        <!-- The name and text stand beside the card; under it in compact, where they keep the page's width -->
        <Style Selector="StackPanel.cardIntro">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="24,0,0,0" />
        </Style>
        <Style Selector="m|MainView.compact StackPanel.cardIntro">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- Header: back, the card as the game draws it, name, cost / class / set / format, text -->
        <Button Name="BackButton" Classes="ghost" Command="{Binding Back}" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="12,8" ToolTip.Tip="{i:Loc Card.BackTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF004D;" Classes="icon" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource OnSecondaryContainer}" Margin="0,0,4,0" />
                <TextBlock Text="{i:Loc Card.Back}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Grid Margin="0,0,0,24" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <!-- The frame keeps the card's room while its art loads (or is missing), so the name does not jump -->
            <Panel Name="CardFrame" Width="200" Height="290" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image Name="CardImage" Stretch="Uniform" i:CardArt.Card="{Binding CardId}" AutomationProperties.Name="{Binding Name}" />
            </Panel>
            <StackPanel Name="CardFacts" Classes="cardIntro" VerticalAlignment="Center">
                <TextBlock Name="CardName" Text="{Binding Name}" Classes="display" FontSize="{StaticResource FontSizeDisplay}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Facts}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <Border Classes="pill" Background="{StaticResource Surface4}" Padding="8,2" Margin="0,0,8,8">
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Name="CardText" Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0"
                           IsVisible="{Binding Text, Converter={StaticResource Truthy}}" />
                <TextBlock Text="{i:Loc Card.Loading}" Classes="caption" Margin="0,12,0,0" IsVisible="{Binding Loading}" />
            </StackPanel>
        </Grid>

        <!-- The card in ranked games: what the source gives, with its slice and date -->
        <Border Name="StatsCard" Classes="card" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Stats.Title}" Icon="&#xF012A;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource CardTile}" ItemsPanel="{StaticResource CardTilesPanel}" Margin="0,0,-12,0" />
                <TextBlock Name="StatsSource" Text="{Binding StatsSource}" Classes="caption" TextWrapping="Wrap"
                           IsVisible="{Binding StatsSource, Converter={StaticResource Truthy}}" />
                <ContentControl Classes="emptyState" Tag="&#xF012A;" Content="{Binding StatsEmpty}"
                                IsVisible="{Binding StatsEmpty, Converter={StaticResource Truthy}}" />
                <!-- The list did not load (offline, a slow server): one way forward, here where it failed -->
                <Button Name="RetryButton" Classes="ghost" Content="{i:Loc Card.Stats.Retry}" Command="{Binding Retry}" HorizontalAlignment="Center"
                        Margin="0,4,0,8" IsVisible="{Binding StatsFailed}" />
            </StackPanel>
        </Border>

        <!-- Archetypes of the loaded meta whose lists run the card -->
        <Border Name="ArchetypesCard" Classes="card" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Archetypes.Title}" Icon="&#xF0639;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <StackPanel IsVisible="{Binding Archetypes, Converter={StaticResource Truthy}}">
                    <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{i:Loc Card.Col.Archetype}" Classes="caption cardName" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Card.Col.Lists}" Classes="caption cardHead cA1" ToolTip.Tip="{i:Loc Card.Col.ListsTip}" />
                        <TextBlock Grid.Column="2" Text="{i:Loc Card.Col.Copies}" Classes="caption cardHead wide cA2" ToolTip.Tip="{i:Loc Card.Col.CopiesTip}" />
                        <TextBlock Grid.Column="3" Text="{i:Loc Card.Col.WinRate}" Classes="caption cardHead cA3" ToolTip.Tip="{i:Loc Card.Col.WinRateTip}" />
                        <TextBlock Grid.Column="4" Text="{i:Loc Card.Col.Games}" Classes="caption cardHead wide cA4" />
                    </Grid>
                    <ItemsControl Name="ArchetypeRows" ItemsSource="{Binding Archetypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="k:CardArchetypeRow">
                                <Border Classes="row" Padding="8,6">
                                    <Grid ColumnDefinitions="36,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface4}" ClipToBounds="True" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" i:CardArt.Portrait="{Binding HeroId}" />
                                        <StackPanel Grid.Column="1" Classes="cardName" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ClassName}" Classes="caption" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Classes="cardNum cA1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Share}" FontWeight="Bold" TextAlignment="Right" />
                                            <TextBlock Text="{Binding Lists}" Classes="caption" TextAlignment="Right" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Copies}" Classes="cardNumber wide cA2" />
                                        <TextBlock Grid.Column="4" Text="{Binding WinRate}" Classes="cardNumber cA3" FontWeight="Bold"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Games}" Classes="cardNumber wide cA4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MetaSource}" Classes="caption" TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding MetaSource, Converter={StaticResource Truthy}}" />
                </StackPanel>
                <ContentControl Classes="emptyState" Tag="&#xF0639;" Content="{Binding ArchetypesEmpty}"
                                IsVisible="{Binding ArchetypesEmpty, Converter={StaticResource Truthy}}" />
            </StackPanel>
        </Border>

        <!-- The card in each archetype's opening hand -->
        <Border Name="MulliganCard" Classes="card" Margin="0,0,0,24">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Mulligan.Title}" Icon="&#xF012C;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <StackPanel IsVisible="{Binding Mulligan, Converter={StaticResource Truthy}}">
                    <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{i:Loc Card.Col.Archetype}" Classes="caption cardName" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="{i:Loc Card.Col.Keep}" Classes="caption cardHead cM1" ToolTip.Tip="{i:Loc Card.Col.KeepTip}" />
                        <TextBlock Grid.Column="2" Text="{i:Loc Card.Col.HandWinRate}" Classes="caption cardHead wide cM2" ToolTip.Tip="{i:Loc Card.Col.HandWinRateTip}" />
                        <TextBlock Grid.Column="3" Text="{i:Loc Card.Col.Impact}" Classes="caption cardHead cM1" ToolTip.Tip="{i:Loc Card.Col.ImpactTip}" />
                        <TextBlock Grid.Column="4" Text="{i:Loc Card.Col.Hands}" Classes="caption cardHead wide cM4" />
                    </Grid>
                    <ItemsControl Name="MulliganRows" ItemsSource="{Binding Mulligan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="k:CardMulliganRow">
                                <Border Classes="row" Padding="8,6">
                                    <Grid ColumnDefinitions="36,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface4}" ClipToBounds="True" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" i:CardArt.Portrait="{Binding HeroId}" />
                                        <StackPanel Grid.Column="1" Classes="cardName" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ClassName}" Classes="caption" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding KeepRate}" Classes="cardNumber cM1" />
                                        <TextBlock Grid.Column="3" Text="{Binding WinRate}" Classes="cardNumber wide cM2" />
                                        <TextBlock Grid.Column="4" Text="{Binding Impact}" Classes="cardNumber cM1" FontWeight="Bold"
                                                   Foreground="{Binding Edge, Converter={StaticResource SignBrush}}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Hands}" Classes="cardNumber wide cM4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MetaSource}" Classes="caption" TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding MetaSource, Converter={StaticResource Truthy}}" />
                </StackPanel>
                <ContentControl Classes="emptyState" Tag="&#xF012C;" Content="{Binding MulliganEmpty}"
                                IsVisible="{Binding MulliganEmpty, Converter={StaticResource Truthy}}" />
            </StackPanel>
        </Border>

        <!-- The player's own games with the card: local history only -->
        <Border Name="MineCard" Classes="card">
            <StackPanel>
                <c:Ornament Text="{i:Loc Card.Mine.Title}" Icon="&#xF02DA;" Size="13" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding MineTiles}" ItemTemplate="{StaticResource CardTile}" ItemsPanel="{StaticResource CardTilesPanel}" Margin="0,0,-12,0" />
                <TextBlock Text="{Binding MineNote}" Classes="caption" TextWrapping="Wrap"
                           IsVisible="{Binding MineNote, Converter={StaticResource Truthy}}" />
                <ContentControl Classes="emptyState" Tag="&#xF0004;" Content="{Binding MineEmpty}"
                                IsVisible="{Binding MineEmpty, Converter={StaticResource Truthy}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
